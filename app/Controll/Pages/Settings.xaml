<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:Controll.Services"
             x:Class="Controll.Pages.Settings"
             BackgroundColor="{StaticResource GraphiteGray}">

    <Grid RowDefinitions="Auto, *" Padding="20">

        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <Label Text="Beállítások"
                   FontSize="{StaticResource TitleFontSize}"
                   FontAttributes="Bold"
                   TextColor="{StaticResource White}" />

            <Border x:Name="ConnectedDevicePanel"
                    BackgroundColor="{StaticResource DarkGray}"
                    Stroke="{StaticResource LightGray}"
                    StrokeShape="RoundRectangle 12"
                    Padding="15">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnConnectedPanelTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           x:Name="LblConnectedDevice"
                           TextColor="{StaticResource White}"
                           FontAttributes="Bold"
                           FontSize="{StaticResource MediumFontSize}"
                           VerticalOptions="Center" />
                    <Border Grid.Column="1"
                            x:Name="BtnDisconnect"
                            IsVisible="False"
                            BackgroundColor="{StaticResource PrimaryRed}"
                            StrokeShape="RoundRectangle 40,0,0,40"
                            WidthRequest="120"
                            HeightRequest="40"
                            Padding="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDisconnectClicked" />
                        </Border.GestureRecognizers>
                        <Label Text="Átcsatlakozás" TextColor="{StaticResource White}" FontAttributes="Bold" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1" Margin="0,15,0,0">
            <VerticalStackLayout Spacing="14">

                <!-- ══════════ MÓD - egyszerű választó, gomb nélkül, azonnal küld ══════════ -->
                <Border x:Name="ModeSelectionPanel"
                        BackgroundColor="{StaticResource DarkGray}"
                        Stroke="{StaticResource LightGray}"
                        StrokeShape="RoundRectangle 12"
                        Padding="15"
                        IsVisible="False">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Üzemmód" TextColor="{StaticResource White}" FontAttributes="Bold" FontSize="{StaticResource MediumFontSize}" />
                        <Picker x:Name="ModePicker" Title="Válassz üzemmódot" SelectedIndexChanged="OnModeChanged">
                            <Picker.Items>
                                <x:String>2 hőmérő</x:String>
                                <x:String>1 hőmérő</x:String>
                                <x:String>Páratartalom mérő</x:String>
                                <x:String>1 kapcsoló 1 hőmérő</x:String>
                                <x:String>2 kapcsoló</x:String>
                                <x:String>Kiegészítő modul (hamarosan)</x:String>
                            </Picker.Items>
                        </Picker>

                        <Picker x:Name="SchemePicker" Title="Mentett sémák" />

                        <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="8">
                            <Border Grid.Column="0" BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="45">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSaveSchemeClicked"/></Border.GestureRecognizers>
                                <Label Text="MENTÉS" TextColor="{StaticResource White}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="{StaticResource LightGray}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="45">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnLoadSchemeClicked"/></Border.GestureRecognizers>
                                <Label Text="BETÖLTÉS" TextColor="{StaticResource White}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Column="2" BackgroundColor="{StaticResource LightGray}" StrokeShape="RoundRectangle 22,0,0,22" WidthRequest="45" HeightRequest="45">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnShareSchemeClicked"/></Border.GestureRecognizers>
                                <Label Text="&#8593;" TextColor="{StaticResource White}" FontAttributes="Bold" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Column="3" BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 22,0,0,22" WidthRequest="45" HeightRequest="45">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDeleteSchemeClicked"/></Border.GestureRecognizers>
                                <Label Text="&#128465;" TextColor="{StaticResource White}" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <Label x:Name="LblSchemeStatus" Text="" TextColor="#AEAEB2" FontSize="11" />
                    </VerticalStackLayout>
                </Border>

                <!-- ══════════ KOMPENZÁCIÓ - lenyitható ══════════ -->
                <Border x:Name="CompPanel" BackgroundColor="{StaticResource DarkGray}" Stroke="{StaticResource LightGray}" StrokeShape="RoundRectangle 12" Padding="15" IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Hőmérő beállítások" TextColor="{StaticResource White}" FontAttributes="Bold" FontSize="{StaticResource MediumFontSize}" />
                            <Label Grid.Column="1" x:Name="CompExpandIcon" Text="&#9660;" TextColor="{StaticResource White}" FontSize="14" VerticalOptions="Center" />
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnCompHeaderTapped"/></Grid.GestureRecognizers>
                        </Grid>
                        <VerticalStackLayout x:Name="CompDetailsPanel" Spacing="10" IsVisible="False">
                            <VerticalStackLayout x:Name="SensBlock1" Spacing="6" IsVisible="False">
                                <Label Text="1. szenzor" TextColor="{StaticResource White}" FontAttributes="Bold" />
                                <Picker x:Name="SensType1Picker" Title="Szenzor típusa" SelectedIndexChanged="OnSensTypeChanged" />
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                        <Label Text="Névleges ellenállás (Ω)" TextColor="#AEAEB2" FontSize="12" />
                                        <Entry x:Name="SensR0Entry1" Keyboard="Numeric" TextColor="{StaticResource White}" BackgroundColor="{StaticResource LightGray}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout x:Name="SensT0Box1" Grid.Row="1" Grid.Column="0" Spacing="4">
                                        <Label Text="Alap hőfok (°C)" TextColor="#AEAEB2" FontSize="12" />
                                        <Entry x:Name="SensT0Entry1" Keyboard="Numeric" TextColor="{StaticResource White}" BackgroundColor="{StaticResource LightGray}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout x:Name="SensBetaBox1" Grid.Row="1" Grid.Column="1" Spacing="4">
                                        <Label Text="Béta (β)" TextColor="#AEAEB2" FontSize="12" />
                                        <Entry x:Name="SensBetaEntry1" Keyboard="Numeric" TextColor="{StaticResource White}" BackgroundColor="{StaticResource LightGray}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="SensBlock2" Spacing="6" IsVisible="False">
                                <Label Text="2. szenzor" TextColor="{StaticResource White}" FontAttributes="Bold" />
                                <Picker x:Name="SensType2Picker" Title="Szenzor típusa" SelectedIndexChanged="OnSensTypeChanged" />
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                        <Label Text="Névleges ellenállás (Ω)" TextColor="#AEAEB2" FontSize="12" />
                                        <Entry x:Name="SensR0Entry2" Keyboard="Numeric" TextColor="{StaticResource White}" BackgroundColor="{StaticResource LightGray}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout x:Name="SensT0Box2" Grid.Row="1" Grid.Column="0" Spacing="4">
                                        <Label Text="Alap hőfok (°C)" TextColor="#AEAEB2" FontSize="12" />
                                        <Entry x:Name="SensT0Entry2" Keyboard="Numeric" TextColor="{StaticResource White}" BackgroundColor="{StaticResource LightGray}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout x:Name="SensBetaBox2" Grid.Row="1" Grid.Column="1" Spacing="4">
                                        <Label Text="Béta (β)" TextColor="#AEAEB2" FontSize="12" />
                                        <Entry x:Name="SensBetaEntry2" Keyboard="Numeric" TextColor="{StaticResource White}" BackgroundColor="{StaticResource LightGray}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                            <Border x:Name="SaveSensButton" BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="45" IsVisible="False">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSaveSensClicked"/></Border.GestureRecognizers>
                                <Label Text="SZENZOR-BEÁLLÍTÁSOK MENTÉSE" TextColor="{StaticResource White}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="Kompenzáció: hozzáadódik a mért hőfokhoz (lehet negatív is)." TextColor="#AEAEB2" FontSize="12" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="NTC1 (°C)" TextColor="#AEAEB2" FontSize="12" />
                                    <Entry x:Name="CompNtc1Entry" Keyboard="Numeric" TextColor="{StaticResource White}" BackgroundColor="{StaticResource LightGray}" Placeholder="0.0" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="NTC2 (°C)" TextColor="#AEAEB2" FontSize="12" />
                                    <Entry x:Name="CompNtc2Entry" Keyboard="Numeric" TextColor="{StaticResource White}" BackgroundColor="{StaticResource LightGray}" Placeholder="0.0" />
                                </VerticalStackLayout>
                            </Grid>
                            <Border BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="45">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSaveCompClicked"/></Border.GestureRecognizers>
                                <Label Text="KOMPENZÁCIÓ MENTÉSE" TextColor="{StaticResource White}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ══════════ OKOSOTTHON (MQTT / HOME ASSISTANT) - lenyitható ══════════ -->
                <Border x:Name="MqttPanel" BackgroundColor="{StaticResource DarkGray}" Stroke="{StaticResource LightGray}" StrokeShape="RoundRectangle 12" Padding="15" IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Okosotthon (MQTT / Home Assistant)" TextColor="{StaticResource White}" FontAttributes="Bold" FontSize="{StaticResource MediumFontSize}" />
                            <Label Grid.Column="1" x:Name="MqttExpandIcon" Text="&#9660;" TextColor="{StaticResource White}" FontSize="14" VerticalOptions="Center" />
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnMqttHeaderTapped"/></Grid.GestureRecognizers>
                        </Grid>
                        <VerticalStackLayout x:Name="MqttDetailsPanel" Spacing="10" IsVisible="False">
                            <Label Text="Az eszköz a WiFi-n át csatlakozik az MQTT-brókerhez (pl. a Home Assistant Mosquitto-jához), és magát automatikusan bejelenti a Home Assistantnak. A Google Home, Alexa vagy Apple Home a Home Assistanton keresztül éri el. Előbb a WiFi-t kell beállítani." TextColor="#AEAEB2" FontSize="12" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="MQTT bekapcsolva" TextColor="{StaticResource White}" VerticalOptions="Center" />
                                <Switch Grid.Column="1" x:Name="MqttEnabledSwitch" />
                            </Grid>
                            <Grid ColumnDefinitions="*,110" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="Bróker címe (IP vagy név)" TextColor="#AEAEB2" FontSize="12" />
                                    <Entry x:Name="MqttHostEntry" Keyboard="Url" TextColor="{StaticResource White}" BackgroundColor="{StaticResource LightGray}" Placeholder="pl. 192.168.1.10" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Port" TextColor="#AEAEB2" FontSize="12" />
                                    <Entry x:Name="MqttPortEntry" Keyboard="Numeric" TextColor="{StaticResource White}" BackgroundColor="{StaticResource LightGray}" Text="1883" />
                                </VerticalStackLayout>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="Felhasználó" TextColor="#AEAEB2" FontSize="12" />
                                    <Entry x:Name="MqttUserEntry" TextColor="{StaticResource White}" BackgroundColor="{StaticResource LightGray}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Jelszó" TextColor="#AEAEB2" FontSize="12" />
                                    <Entry x:Name="MqttPassEntry" IsPassword="True" TextColor="{StaticResource White}" BackgroundColor="{StaticResource LightGray}" />
                                </VerticalStackLayout>
                            </Grid>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Az eszköz neve a Home Assistantban" TextColor="#AEAEB2" FontSize="12" />
                                <Entry x:Name="MqttNameEntry" TextColor="{StaticResource White}" BackgroundColor="{StaticResource LightGray}" Placeholder="pl. Terrárium" />
                            </VerticalStackLayout>
                            <Label x:Name="LblMqttStatus" Text="" TextColor="#AEAEB2" FontSize="12" />
                            <Border BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="45">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSaveMqttClicked"/></Border.GestureRecognizers>
                                <Label Text="MQTT BEÁLLÍTÁSOK MENTÉSE" TextColor="{StaticResource White}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ══════════ ÉRTESÍTÉSEK (RIASZTÁSOK) - lenyitható ══════════ -->
                <Border x:Name="AlertPanel" BackgroundColor="{StaticResource DarkGray}" Stroke="{StaticResource LightGray}" StrokeShape="RoundRectangle 12" Padding="15" IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Értesítések (riasztások)" TextColor="{StaticResource White}" FontAttributes="Bold" FontSize="{StaticResource MediumFontSize}" />
                            <Label Grid.Column="1" x:Name="AlertExpandIcon" Text="&#9660;" TextColor="{StaticResource White}" FontSize="14" VerticalOptions="Center" />
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnAlertHeaderTapped"/></Grid.GestureRecognizers>
                        </Grid>
                        <VerticalStackLayout x:Name="AlertDetailsPanel" Spacing="10" IsVisible="False">
                            <Label Text="Az eszköz értesítést küld a telefonra, ha a hőmérő meghibásodik, vagy a hőmérséklet kilép a megadott határok közül. Az értesítés akkor érkezik meg, ha a telefon kapcsolatban van az eszközzel (Bluetooth hatótávon belül, a háttérfigyelés bekapcsolva). Távoli értesítéshez használd az MQTT / Home Assistant kapcsolatot." TextColor="#AEAEB2" FontSize="12" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Riasztások bekapcsolva" TextColor="{StaticResource White}" VerticalOptions="Center" />
                                <Switch Grid.Column="1" x:Name="AlertEnabledSwitch" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Szenzorhiba (szakadt szál, rövidzár, értelmezhetetlen érték)" TextColor="{StaticResource White}" VerticalOptions="Center" />
                                <Switch Grid.Column="1" x:Name="AlertFaultSwitch" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Túl alacsony hőmérséklet" TextColor="{StaticResource White}" VerticalOptions="Center" />
                                <Switch Grid.Column="1" x:Name="AlertLowSwitch" />
                            </Grid>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Alsó határ (°C) - ez alatt riaszt" TextColor="#AEAEB2" FontSize="12" />
                                <Entry x:Name="AlertLowEntry" Keyboard="Numeric" TextColor="{StaticResource White}" BackgroundColor="{StaticResource LightGray}" Text="5" />
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Túl magas hőmérséklet" TextColor="{StaticResource White}" VerticalOptions="Center" />
                                <Switch Grid.Column="1" x:Name="AlertHighSwitch" />
                            </Grid>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Felső határ (°C) - ez felett riaszt" TextColor="#AEAEB2" FontSize="12" />
                                <Entry x:Name="AlertHighEntry" Keyboard="Numeric" TextColor="{StaticResource White}" BackgroundColor="{StaticResource LightGray}" Text="35" />
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Háttérben is figyeljen (állandó értesítés a sávban)" TextColor="{StaticResource White}" VerticalOptions="Center" />
                                <Switch Grid.Column="1" x:Name="AlertBgSwitch" />
                            </Grid>
                            <Border BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="45">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSaveAlertClicked"/></Border.GestureRecognizers>
                                <Label Text="ÉRTESÍTÉSEK MENTÉSE" TextColor="{StaticResource White}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ══════════ KIJELZŐ - lenyitható ══════════ -->
                <Border x:Name="DisplayPanel" BackgroundColor="{StaticResource DarkGray}" Stroke="{StaticResource LightGray}" StrokeShape="RoundRectangle 12" Padding="15" IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Kijelző" TextColor="{StaticResource White}" FontAttributes="Bold" FontSize="{StaticResource MediumFontSize}" />
                            <Label Grid.Column="1" x:Name="DisplayExpandIcon" Text="&#9660;" TextColor="{StaticResource White}" FontSize="14" VerticalOptions="Center" />
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnDisplayHeaderTapped"/></Grid.GestureRecognizers>
                        </Grid>
                        <VerticalStackLayout x:Name="DisplayDetailsPanel" Spacing="10" IsVisible="False">
                            <Label Text="Fényerő" TextColor="#AEAEB2" FontSize="12" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Slider Grid.Column="0" x:Name="BrightnessSlider" Minimum="1" Maximum="100"
                                        ThumbColor="{StaticResource White}"
                                        MinimumTrackColor="{StaticResource PrimaryRed}"
                                        MaximumTrackColor="{StaticResource LightGray}"
                                        ValueChanged="OnBrightnessChanged" />
                                <Label Grid.Column="1" x:Name="BrightnessLabel" Text="100%" TextColor="{StaticResource White}" VerticalOptions="Center" WidthRequest="45" />
                            </Grid>

                            <Label Text="Elalvási idő" TextColor="#AEAEB2" FontSize="12" />
                            <Picker x:Name="SleepTimeoutPicker">
                                <Picker.Items>
                                    <x:String>10 mp</x:String>
                                    <x:String>30 mp</x:String>
                                    <x:String>1 perc</x:String>
                                    <x:String>3 perc</x:String>
                                    <x:String>5 perc</x:String>
                                    <x:String>10 perc</x:String>
                                    <x:String>30 perc</x:String>
                                    <x:String>1 óra</x:String>
                                    <x:String>Soha</x:String>
                                </Picker.Items>
                            </Picker>

                            <Border BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="45">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSaveDisplayClicked"/></Border.GestureRecognizers>
                                <Label Text="KIJELZŐ BEÁLLÍTÁSOK MENTÉSE" TextColor="{StaticResource White}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ══════════ DÁTUM/IDŐ - lenyitható ══════════ -->
                <Border x:Name="DateTimePanel" BackgroundColor="{StaticResource DarkGray}" Stroke="{StaticResource LightGray}" StrokeShape="RoundRectangle 12" Padding="15" IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Dátum/Idő" TextColor="{StaticResource White}" FontAttributes="Bold" FontSize="{StaticResource MediumFontSize}" />
                            <Label Grid.Column="1" x:Name="DateTimeExpandIcon" Text="&#9660;" TextColor="{StaticResource White}" FontSize="14" VerticalOptions="Center" />
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnDateTimeHeaderTapped"/></Grid.GestureRecognizers>
                        </Grid>
                        <VerticalStackLayout x:Name="DateTimeDetailsPanel" Spacing="10" IsVisible="False">
                            <Label Text="Idő formátum" TextColor="#AEAEB2" FontSize="12" />
                            <Picker x:Name="TimeFormatPicker">
                                <Picker.Items>
                                    <x:String>Ó:P:MP</x:String>
                                    <x:String>Ó:P</x:String>
                                    <x:String>AM/PM</x:String>
                                </Picker.Items>
                            </Picker>

                            <Label Text="Dátum formátum" TextColor="#AEAEB2" FontSize="12" />
                            <Picker x:Name="DateFormatPicker">
                                <Picker.Items>
                                    <x:String>Év/Hónap/Nap</x:String>
                                    <x:String>Nap/Hónap/Év</x:String>
                                    <x:String>Hónap/Nap/Év</x:String>
                                    <x:String>Hónap/Nap (év nélkül)</x:String>
                                    <x:String>Nap/Hónap (év nélkül)</x:String>
                                </Picker.Items>
                            </Picker>

                            <Label Text="Óra megjelenítése" TextColor="#AEAEB2" FontSize="12" />
                            <Picker x:Name="ClockPosPicker">
                                <Picker.Items>
                                    <x:String>Ki</x:String>
                                    <x:String>Balra</x:String>
                                    <x:String>Középen</x:String>
                                </Picker.Items>
                            </Picker>

                            <Label Text="Dátum megjelenítése" TextColor="#AEAEB2" FontSize="12" />
                            <Picker x:Name="DatePosPicker">
                                <Picker.Items>
                                    <x:String>Ki</x:String>
                                    <x:String>Balra</x:String>
                                    <x:String>Középen</x:String>
                                </Picker.Items>
                            </Picker>

                            <Label Text="Nap neve megjelenítése" TextColor="#AEAEB2" FontSize="12" />
                            <Picker x:Name="DayNamePosPicker">
                                <Picker.Items>
                                    <x:String>Ki</x:String>
                                    <x:String>Balra</x:String>
                                    <x:String>Középen</x:String>
                                </Picker.Items>
                            </Picker>

                            <Border BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="45">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSaveDateTimeClicked"/></Border.GestureRecognizers>
                                <Label Text="DÁTUM/IDŐ BEÁLLÍTÁSOK MENTÉSE" TextColor="{StaticResource White}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <Label Text="A dátumot és a pontos időt az app minden csatlakozáskor automatikusan elküldi az eszköznek - ezt nem kell (és nem is lehet) kézzel beállítani."
                                   TextColor="#AEAEB2" FontSize="11" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ══════════ ESZKÖZ WIFI - lenyitható ══════════ -->
                <Border x:Name="WifiPanel" BackgroundColor="{StaticResource DarkGray}" Stroke="{StaticResource LightGray}" StrokeShape="RoundRectangle 12" Padding="15" IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Eszköz WiFi" TextColor="{StaticResource White}" FontAttributes="Bold" FontSize="{StaticResource MediumFontSize}" />
                            <Label Grid.Column="1" x:Name="WifiExpandIcon" Text="&#9660;" TextColor="{StaticResource White}" FontSize="14" VerticalOptions="Center" />
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnWifiHeaderTapped"/></Grid.GestureRecognizers>
                        </Grid>
                        <VerticalStackLayout x:Name="WifiDetailsPanel" Spacing="10" IsVisible="False">
                            <HorizontalStackLayout Spacing="8">
                                <Ellipse x:Name="WifiStatusDot" Fill="Gray" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" />
                                <Label x:Name="LblWifiStatus" Text="WiFi állapot: ismeretlen" TextColor="#AEAEB2" FontSize="12" VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Ha van mentett hálózat (csatlakozva VAGY épp csatlakozik): keresni nem lehet -->
                            <VerticalStackLayout x:Name="WifiConnectedView" Spacing="10" IsVisible="False">
                                <Label x:Name="LblWifiConnectedSsid" Text="Csatlakozva: --" TextColor="{StaticResource White}" FontAttributes="Bold" FontSize="{StaticResource MediumFontSize}" />
                                <Border BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="45">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDisconnectWifiClicked"/></Border.GestureRecognizers>
                                    <Label Text="KAPCSOLAT BONTÁSA ÉS ELFELEJTÉSE" TextColor="{StaticResource White}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- Ha NINCS mentett hálózat: keresés + csatlakozás UI -->
                            <VerticalStackLayout x:Name="WifiDisconnectedView" Spacing="10" IsVisible="True">
                                <Border BackgroundColor="{StaticResource LightGray}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="45">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnScanWifiClicked"/></Border.GestureRecognizers>
                                    <Label Text="HÁLÓZATOK KERESÉSE" TextColor="{StaticResource White}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>

                                <ActivityIndicator x:Name="WifiScanIndicator" IsRunning="False" Color="{StaticResource PrimaryRed}" HorizontalOptions="Center" />

                                <Picker x:Name="WifiNetworksPicker" Title="Válassz hálózatot" IsVisible="False" SelectedIndexChanged="OnWifiNetworkSelected" />

                                <Label Text="Jelszó" TextColor="#AEAEB2" FontSize="12" />
                                <Entry x:Name="WifiPasswordEntry" TextColor="{StaticResource White}" BackgroundColor="{StaticResource LightGray}" IsPassword="True" Placeholder="Jelszó" />

                                <Border BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="45">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSaveWifiClicked"/></Border.GestureRecognizers>
                                    <Label Text="CSATLAKOZÁS" TextColor="{StaticResource White}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ══════════ FIRMWARE - lenyitható ══════════ -->
                <Border x:Name="GitHubOtaPanel" BackgroundColor="{StaticResource DarkGray}" Stroke="{StaticResource LightGray}" StrokeShape="RoundRectangle 12" Padding="15" IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Firmware" TextColor="{StaticResource White}" FontAttributes="Bold" FontSize="{StaticResource MediumFontSize}" />
                            <Label Grid.Column="1" x:Name="FirmwareExpandIcon" Text="&#9660;" TextColor="{StaticResource White}" FontSize="14" VerticalOptions="Center" />
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnFirmwareHeaderTapped"/></Grid.GestureRecognizers>
                        </Grid>
                        <VerticalStackLayout x:Name="FirmwareDetailsPanel" Spacing="10" IsVisible="False">
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="Jelenlegi verzió:" TextColor="#AEAEB2" />
                                <Label x:Name="LblFirmwareVersion" Text="Lekérdezés..." TextColor="{StaticResource White}" />
                            </HorizontalStackLayout>

                            <Label x:Name="LblUpdateAvailable" Text="" TextColor="{StaticResource PrimaryRed}" FontAttributes="Bold" IsVisible="False" />

                            <Border BackgroundColor="{StaticResource LightGray}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="45">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCheckReleasesClicked"/></Border.GestureRecognizers>
                                <Label Text="ELÉRHETŐ VERZIÓK LEKÉRÉSE" TextColor="{StaticResource White}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <Picker x:Name="ReleasePicker" Title="Válassz verziót (fel- vagy visszaállás)" IsVisible="False" />

                            <Border x:Name="BtnGitHubUpdate"
                                    IsVisible="False"
                                    BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="45">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnGitHubUpdateClicked"/></Border.GestureRecognizers>
                                <Label Text="KIVÁLASZTOTT VERZIÓ TELEPÍTÉSE" TextColor="{StaticResource White}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource LightGray}" Margin="0,10" />

                            <Border BackgroundColor="{StaticResource LightGray}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="45">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnUpdateFirmwareClicked"/></Border.GestureRecognizers>
                                <Label Text="FIRMWARE FRISSÍTÉS HELYI FÁJLBÓL (.bin)" TextColor="{StaticResource White}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout x:Name="UpdateProgressLayout" IsVisible="False" Spacing="5">
                                <ProgressBar x:Name="UpdateProgressBar" ProgressColor="{StaticResource PrimaryRed}" HeightRequest="10" />
                                <Label x:Name="LblUpdateStatus" Text="0%" TextColor="#AEAEB2" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ══════════ GYÁRI VISSZAÁLLÍTÁS - lenyitható ══════════ -->
                <Border x:Name="FactoryResetPanel" BackgroundColor="{StaticResource DarkGray}" Stroke="{StaticResource LightGray}" StrokeShape="RoundRectangle 12" Padding="15" IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Gyári visszaállítás" TextColor="{StaticResource White}" FontAttributes="Bold" FontSize="{StaticResource MediumFontSize}" />
                            <Label Grid.Column="1" x:Name="FactoryResetExpandIcon" Text="&#9660;" TextColor="{StaticResource White}" FontSize="14" VerticalOptions="Center" />
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnFactoryResetHeaderTapped"/></Grid.GestureRecognizers>
                        </Grid>
                        <VerticalStackLayout x:Name="FactoryResetDetailsPanel" Spacing="10" IsVisible="False">
                            <Label Text="Minden mentett beállítás törlődik, az eszköz újraindul." TextColor="#AEAEB2" FontSize="12" />
                            <Border BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="45">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFactoryResetClicked"/></Border.GestureRecognizers>
                                <Label Text="GYÁRI VISSZAÁLLÍTÁS" TextColor="{StaticResource White}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ══════════ KÖZELEDÉS ÉRZÉKELÉS - lenyitható, mindig látszik ══════════ -->
                <Border x:Name="ProximityPanel" IsVisible="False" BackgroundColor="{StaticResource DarkGray}" Stroke="{StaticResource LightGray}" StrokeShape="RoundRectangle 12" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Közeledés érzékelés" TextColor="{StaticResource White}" FontAttributes="Bold" FontSize="{StaticResource MediumFontSize}" />
                            <Label Grid.Column="1" x:Name="ProxExpandIcon" Text="&#9660;" TextColor="{StaticResource White}" FontSize="14" VerticalOptions="Center" />
                            <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnProxHeaderTapped"/></Grid.GestureRecognizers>
                        </Grid>
                        <VerticalStackLayout x:Name="ProxDetailsPanel" Spacing="10" IsVisible="False">
                            <Label Text="Ha az eszköz a megadott távolságon belülre kerül, az app magától csatlakozik hozzá, és elindítja a Vezérlés → Automatikák (ventilátor, relé) és az RGB oldalon beállított közeledés-műveleteket. A távolság a Bluetooth jelerősségből becsült érték: falak, test és környezet miatt több méteres eltérés is lehet. Ez a beállítás a most csatlakoztatott eszközre vonatkozik. Több mentett eszköz esetén a közeledést mindig az utoljára használt eszközre figyeli az app. A működéshez a háttérfigyelés (állandó értesítés) fut." TextColor="#AEAEB2" FontSize="12" />
                            <Label x:Name="LblProxEmpty" Text="Előbb csatlakozz egy eszközhöz, hogy mentett eszköz legyen." TextColor="#AEAEB2" FontSize="12" />
                            <VerticalStackLayout x:Name="ProxFields" Spacing="10">
                                <Picker x:Name="ProxDevicePicker" IsVisible="False" Title="Válassz eszközt" SelectedIndexChanged="OnProxDeviceChanged" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="Közeledés érzékelés ennél az eszköznél" TextColor="{StaticResource White}" VerticalOptions="Center" />
                                    <Switch Grid.Column="1" x:Name="ProxEnabledSwitch" />
                                </Grid>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Távolság (méter) - ezen belül csatlakozik és indítja a műveleteket" TextColor="#AEAEB2" FontSize="12" />
                                    <Entry x:Name="ProxMetersEntry" Keyboard="Numeric" TextColor="{StaticResource White}" BackgroundColor="{StaticResource LightGray}" Text="10" />
                                </VerticalStackLayout>
                                <Label Text="Újraélesedés - mikor indítsa újra a műveleteket" TextColor="#AEAEB2" FontSize="12" />
                                <Picker x:Name="ProxRearmPicker" Title="Válassz" SelectedIndexChanged="OnProxRearmChanged">
                                    <Picker.Items>
                                        <x:String>Teljes kapcsolatszakadás után</x:String>
                                        <x:String>Ha X méteren kívül vagyok</x:String>
                                        <x:String>X mp múlva, ha X méteren kívül vagyok</x:String>
                                    </Picker.Items>
                                </Picker>
                                <VerticalStackLayout x:Name="ProxRearmMetersBox" Spacing="4">
                                    <Label Text="X méter (a közeledési távolságnál nagyobb legyen)" TextColor="#AEAEB2" FontSize="12" />
                                    <Entry x:Name="ProxRearmMetersEntry" Keyboard="Numeric" TextColor="{StaticResource White}" BackgroundColor="{StaticResource LightGray}" Text="15" />
                                </VerticalStackLayout>
                                <VerticalStackLayout x:Name="ProxRearmSecBox" Spacing="4">
                                    <Label Text="X másodperc" TextColor="#AEAEB2" FontSize="12" />
                                    <Entry x:Name="ProxRearmSecEntry" Keyboard="Numeric" TextColor="{StaticResource White}" BackgroundColor="{StaticResource LightGray}" Text="30" />
                                </VerticalStackLayout>
                                <Border BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="45">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSaveProxClicked"/></Border.GestureRecognizers>
                                    <Label Text="KÖZELEDÉS BEÁLLÍTÁSOK MENTÉSE" TextColor="{StaticResource White}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ══════════ ESZKÖZ KERESÉSE - csak akkor látszik, ha NINCS csatlakozás ══════════ -->
                <VerticalStackLayout x:Name="DeviceSearchSection" Spacing="12">
                    <Border x:Name="BtnSearch"
                            BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="55">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBTSearchClicked"/></Border.GestureRecognizers>
                        <Label Text="ESZKÖZÖK KERESÉSE" TextColor="{StaticResource White}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <ActivityIndicator x:Name="ScanIndicator" IsRunning="False" Color="{StaticResource PrimaryRed}" HorizontalOptions="Center" />

                    <Label x:Name="LblDeviceListHeader" Text="Mentett eszközök" IsVisible="False"
                           TextColor="{StaticResource White}" FontAttributes="Bold" FontSize="{StaticResource MediumFontSize}" />

                    <CollectionView x:Name="DevicesListView" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="svc:DeviceRow">
                                <!-- x:Name="DeviceRowBorder": a kijelölési visszajelzést (érintéskor
                                     azonnal kiemelt szín) a code-behind közvetlenül ezen a Border-on
                                     állítja be a sender-ből, ez félreérthetetlenül mutatja, MELYIK
                                     eszközre koppintottál - nem a natív CollectionView-selection. -->
                                <Border x:Name="DeviceRowBorder"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{StaticResource DarkGray}"
                                        Stroke="{StaticResource LightGray}"
                                        StrokeThickness="1"
                                        Padding="15"
                                        Margin="0,4"
                                        Loaded="OnDeviceRowLoaded">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDeviceRowTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="15">
                                        <Border Grid.Column="0" BackgroundColor="{StaticResource PrimaryRed}"
                                                StrokeShape="RoundRectangle 20,0,0,20"
                                                WidthRequest="40" HeightRequest="40" Padding="0" />
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding Title}" TextColor="{StaticResource White}" FontAttributes="Bold" FontSize="{StaticResource MediumFontSize}" />
                                            <Label Text="{Binding Subtitle}" TextColor="#AEAEB2" FontSize="12" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="✎" TextColor="{StaticResource White}" FontSize="22" VerticalOptions="Center" Padding="10">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnDeviceEditTapped" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
