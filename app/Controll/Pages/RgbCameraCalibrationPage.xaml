<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Controll.Pages"
             x:Class="Controll.Pages.RgbCameraCalibrationPage"
             Title="Kalibrálás kamerával">

    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="12">

            <Border BackgroundColor="Black" StrokeShape="RoundRectangle 12" HeightRequest="360">
                <pages:CameraPreviewView x:Name="Preview" HorizontalOptions="Fill" VerticalOptions="Fill" />
            </Border>

            <Label Text="Irányítsd a LED-re, sötétben, nyugodt kézzel." TextColor="#AEAEB2" FontSize="13" HorizontalTextAlignment="Center" />

            <ProgressBar x:Name="Progress" Progress="0" ProgressColor="{StaticResource PrimaryRed}" IsVisible="False" />
            <Label x:Name="StatusLabel" Text="" TextColor="{StaticResource White}" FontSize="14" HorizontalTextAlignment="Center" />

            <Border x:Name="StartButton" BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="45" Opacity="0.4">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnStartTapped"/></Border.GestureRecognizers>
                <Label Text="Indítás" TextColor="{StaticResource White}" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
