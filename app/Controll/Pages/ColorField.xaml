<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Controll.Pages.ColorField">

    <!-- Színválasztó mező: előnézet + hex kód (RRGGBB) + gyorsszínek -->
    <VerticalStackLayout Spacing="6">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 8" Stroke="#000000" StrokeThickness="1">
                <BoxView x:Name="Preview" Color="White" />
            </Border>
            <Entry Grid.Column="1" x:Name="HexEntry" Placeholder="RRGGBB" MaxLength="7" Text="FFFFFF"
                   TextColor="White" BackgroundColor="{StaticResource ControlGray}" HeightRequest="40" TextChanged="OnHexChanged" />
        </Grid>
        <FlexLayout x:Name="Swatches" Wrap="Wrap" JustifyContent="Start" />
    </VerticalStackLayout>
</ContentView>
