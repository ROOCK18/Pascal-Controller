<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Controll.Pages"
             x:Class="Controll.Pages.RgbCalibrationPage"
             Title="Színkalibrálás"
             BackgroundColor="#1A1A1A">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="Tartsd a kamerát a LED-szalag (vagy a megvilágított fehér fal) felé. Sötét helyiségben, nyugodt kézzel (támaszd meg a telefont) pontosabb."
                   TextColor="#AEAEB2" FontSize="13" />

            <Border StrokeShape="RoundRectangle 10" Stroke="#3A3A3C" BackgroundColor="Black" HeightRequest="320">
                <pages:CameraPreviewView x:Name="Preview" HorizontalOptions="Fill" VerticalOptions="Fill" />
            </Border>

            <ProgressBar x:Name="Progress" Progress="0" ProgressColor="#FF453A" IsVisible="False" />
            <Label x:Name="StatusLabel" Text="" TextColor="White" FontSize="14" HorizontalTextAlignment="Center" />

            <Button x:Name="StartButton" Text="INDÍTÁS" Clicked="OnStartClicked"
                    BackgroundColor="#FF453A" TextColor="White" FontAttributes="Bold"
                    HeightRequest="52" CornerRadius="10" IsEnabled="False" />

            <Label x:Name="ResultLabel" Text="" TextColor="White" FontSize="13" />

            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Kalibráció használata" TextColor="White" FontSize="15" />
                    <Label x:Name="StoredLabel" Text="Az eszközön: ?" TextColor="#AEAEB2" FontSize="12" />
                </VerticalStackLayout>
                <Switch x:Name="UseSwitch" Grid.Column="1" OnColor="#FF453A" Toggled="OnUseToggled" />
            </Grid>

            <Button Text="KALIBRÁCIÓ TÖRLÉSE" Clicked="OnResetClicked"
                    BackgroundColor="#3A3A3C" TextColor="White"
                    HeightRequest="44" CornerRadius="10" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
