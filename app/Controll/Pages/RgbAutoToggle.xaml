<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Controll.Pages.RgbAutoToggle">

    <!-- RGB Automata / Kézi kapcsoló (ugyanaz a kinézet, mint a ventilátor/relé kapcsolónál) -->
    <Border x:Name="AutoBorder" BackgroundColor="{StaticResource PrimaryRed}" Stroke="#000000" StrokeThickness="1"
            StrokeShape="RoundRectangle 12,0,0,12" Padding="6,2" WidthRequest="72" HeightRequest="24" HorizontalOptions="Center">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped"/>
        </Border.GestureRecognizers>
        <Label x:Name="AutoLabel" Text="Kézi" FontSize="11" TextColor="{StaticResource White}" HorizontalOptions="Center" VerticalOptions="Center"/>
    </Border>
</ContentView>
