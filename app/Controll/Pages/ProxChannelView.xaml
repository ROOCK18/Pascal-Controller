<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Controll.Pages"
             x:Class="Controll.Pages.ProxChannelView">

    <!-- Egy csatorna közeledés-beállítása: legördülő (alapból összecsukva). Lenyitva azonnal látszik minden beállítás,
         a tetején a bekapcsoló kapcsolóval. Ventilátor 1-2, relé 1-2 (Automatikák oldal) és RGB (RGB automatikák oldal) ugyanezt használja. -->
    <VerticalStackLayout Spacing="8">
        <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <Label Grid.Column="0" Text="Közeledés" FontSize="15" FontAttributes="Bold" TextColor="White" />
            <Label Grid.Column="1" x:Name="ExpandIcon" Text="&#9660;" TextColor="White" FontSize="16" VerticalOptions="Center" />
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnHeaderTapped"/>
            </Grid.GestureRecognizers>
        </Grid>

        <VerticalStackLayout x:Name="DetailsPanel" Spacing="8" IsVisible="False">
            <HorizontalStackLayout Spacing="10">
                <Label Text="Bekapcsolva" TextColor="Gray" FontSize="13" VerticalOptions="Center" />
                <Switch x:Name="EnabledSwitch" />
            </HorizontalStackLayout>

            <Label x:Name="LblIntro" Text="" TextColor="Gray" FontSize="12" />

            <Label Text="Távolság (méter) - ezen belül hajtja végre" TextColor="Gray" FontSize="12" />
            <Entry x:Name="MetersEntry" Keyboard="Numeric" TextColor="White" BackgroundColor="#3A3A3A" HeightRequest="40" Text="10" />

            <VerticalStackLayout x:Name="FanValueBox" Spacing="4">
                <Label Text="Mit csináljon: fordulatszám (%)" TextColor="Gray" FontSize="12" />
                <Entry x:Name="ValueEntry" Keyboard="Numeric" TextColor="White" BackgroundColor="#3A3A3A" HeightRequest="40" Text="100" />
            </VerticalStackLayout>
            <VerticalStackLayout x:Name="ActionBox" Spacing="4">
                <Label Text="Mit csináljon" TextColor="Gray" FontSize="12" />
                <Picker x:Name="ActionPicker" TextColor="White" BackgroundColor="#3A3A3A" />
            </VerticalStackLayout>

            <!-- RGB: szín, fényerő, felfutás, világítási mód, lefutás (csak az RGB automatikák oldalon) -->
            <VerticalStackLayout x:Name="RgbBox" Spacing="6" IsVisible="False">
                <Label Text="Szín (ezzel világít fel)" TextColor="Gray" FontSize="12" />
                <pages:ColorField x:Name="RgbColor" />
                <Label Text="Fényerő (%)" TextColor="Gray" FontSize="12" />
                <Entry x:Name="RgbPctEntry" Keyboard="Numeric" TextColor="White" BackgroundColor="#3A3A3A" HeightRequest="40" Text="100" />
                <Label Text="Felfutási idő (mp) - ennyi idő alatt fényesedik fel" TextColor="Gray" FontSize="12" />
                <Entry x:Name="RgbRampUpEntry" Keyboard="Numeric" TextColor="White" BackgroundColor="#3A3A3A" HeightRequest="40" Text="5" />
                <Label Text="Világítási mód" TextColor="Gray" FontSize="12" />
                <Picker x:Name="RgbModePicker" TextColor="White" BackgroundColor="#3A3A3A" SelectedIndexChanged="OnRgbModeChanged">
                    <Picker.Items>
                        <x:String>Csak felkapcsol (utána az automatika dönt)</x:String>
                        <x:String>Amíg ott vagyok világít</x:String>
                        <x:String>X mp-ig világít</x:String>
                    </Picker.Items>
                </Picker>
                <VerticalStackLayout x:Name="RgbHoldBox" Spacing="4">
                    <Label Text="Világítási idő (mp) a felfutás után" TextColor="Gray" FontSize="12" />
                    <Entry x:Name="RgbHoldEntry" Keyboard="Numeric" TextColor="White" BackgroundColor="#3A3A3A" HeightRequest="40" Text="60" />
                </VerticalStackLayout>
                <Label Text="Lefutási idő (mp) - kikapcsoláskor ennyi idő alatt halványul le (0 = azonnal)" TextColor="Gray" FontSize="12" />
                <Entry x:Name="RgbRampDownEntry" Keyboard="Numeric" TextColor="White" BackgroundColor="#3A3A3A" HeightRequest="40" Text="5" />
            </VerticalStackLayout>

            <Label x:Name="LblDur" Text="Meddig (mp)" TextColor="Gray" FontSize="12" />
            <Entry x:Name="DurEntry" Keyboard="Numeric" TextColor="White" BackgroundColor="#3A3A3A" HeightRequest="40" Text="60" />

            <Label Text="Újraélesedés - mikor hajtsa végre újra" TextColor="Gray" FontSize="12" />
            <Picker x:Name="RearmPicker" TextColor="White" BackgroundColor="#3A3A3A" SelectedIndexChanged="OnRearmChanged">
                <Picker.Items>
                    <x:String>Teljes kapcsolatszakadás után</x:String>
                    <x:String>Ha X méteren kívül vagyok</x:String>
                    <x:String>X mp múlva, ha X méteren kívül vagyok</x:String>
                </Picker.Items>
            </Picker>
            <VerticalStackLayout x:Name="RearmMetersBox" Spacing="4">
                <Label Text="X méter (a végrehajtási távolságnál nagyobb legyen)" TextColor="Gray" FontSize="12" />
                <Entry x:Name="RearmMetersEntry" Keyboard="Numeric" TextColor="White" BackgroundColor="#3A3A3A" HeightRequest="40" Text="15" />
            </VerticalStackLayout>
            <VerticalStackLayout x:Name="RearmSecBox" Spacing="4">
                <Label Text="X másodperc" TextColor="Gray" FontSize="12" />
                <Entry x:Name="RearmSecEntry" Keyboard="Numeric" TextColor="White" BackgroundColor="#3A3A3A" HeightRequest="40" Text="30" />
            </VerticalStackLayout>

            <Border x:Name="SaveButton" BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="42">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSaveTapped"/></Border.GestureRecognizers>
                <Label Text="KÖZELEDÉS MENTÉSE" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
