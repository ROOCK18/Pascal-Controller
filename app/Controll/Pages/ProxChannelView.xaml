<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Controll.Pages.ProxChannelView">

    <!-- Egy csatorna közeledés-beállítása: kapcsoló, bekapcsolva tovább nyílik a részletekkel.
         Ventilátor 1-2, relé 1-2 (Automatikák oldal) és RGB (RGB automatikák oldal) ugyanezt használja. -->
    <VerticalStackLayout Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
            <Label Grid.Column="0" Text="Közeledés" TextColor="White" FontAttributes="Bold" VerticalOptions="Center" />
            <Switch Grid.Column="1" x:Name="EnabledSwitch" Toggled="OnToggled" />
        </Grid>

        <VerticalStackLayout x:Name="DetailsPanel" Spacing="8" IsVisible="False">
            <Label x:Name="LblIntro" Text="" TextColor="Gray" FontSize="12" />

            <Label Text="Távolság (méter) - ezen belül hajtja végre" TextColor="Gray" FontSize="12" />
            <Entry x:Name="MetersEntry" Keyboard="Numeric" TextColor="White" BackgroundColor="#3A3A3A" HeightRequest="40" Text="10" />

            <VerticalStackLayout x:Name="FanValueBox" Spacing="4">
                <Label Text="Mit csináljon: fordulatszám (%)" TextColor="Gray" FontSize="12" />
                <Entry x:Name="ValueEntry" Keyboard="Numeric" TextColor="White" BackgroundColor="#3A3A3A" HeightRequest="40" Text="100" />
            </VerticalStackLayout>
            <VerticalStackLayout x:Name="ActionBox" Spacing="4">
                <Label Text="Mit csináljon" TextColor="Gray" FontSize="12" />
                <Picker x:Name="ActionPicker" TextColor="White" BackgroundColor="#3A3A3A" />
            </VerticalStackLayout>

            <Label x:Name="LblDur" Text="Meddig (mp)" TextColor="Gray" FontSize="12" />
            <Entry x:Name="DurEntry" Keyboard="Numeric" TextColor="White" BackgroundColor="#3A3A3A" HeightRequest="40" Text="60" />

            <Label Text="Újraélesedés - mikor hajtsa végre újra" TextColor="Gray" FontSize="12" />
            <Picker x:Name="RearmPicker" TextColor="White" BackgroundColor="#3A3A3A" SelectedIndexChanged="OnRearmChanged">
                <Picker.Items>
                    <x:String>Teljes kapcsolatszakadás után</x:String>
                    <x:String>Ha X méteren kívül vagyok</x:String>
                    <x:String>X mp múlva, ha X méteren kívül vagyok</x:String>
                </Picker.Items>
            </Picker>
            <VerticalStackLayout x:Name="RearmMetersBox" Spacing="4">
                <Label Text="X méter (a végrehajtási távolságnál nagyobb legyen)" TextColor="Gray" FontSize="12" />
                <Entry x:Name="RearmMetersEntry" Keyboard="Numeric" TextColor="White" BackgroundColor="#3A3A3A" HeightRequest="40" Text="15" />
            </VerticalStackLayout>
            <VerticalStackLayout x:Name="RearmSecBox" Spacing="4">
                <Label Text="X másodperc" TextColor="Gray" FontSize="12" />
                <Entry x:Name="RearmSecEntry" Keyboard="Numeric" TextColor="White" BackgroundColor="#3A3A3A" HeightRequest="40" Text="30" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <Border x:Name="SaveButton" BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="42">
            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSaveTapped"/></Border.GestureRecognizers>
            <Label Text="KÖZELEDÉS MENTÉSE" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Border>
    </VerticalStackLayout>
</ContentView>
