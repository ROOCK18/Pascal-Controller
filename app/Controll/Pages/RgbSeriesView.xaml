<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Controll.Pages.RgbSeriesView">

    <!-- Az RGB automatikák három listás legördülője (Kind): Timer = időzítő, Day = napszak-görbe, Therm = hőmérséklet-görbe.
         Alapból összecsukva; lenyitva azonnal látszik minden beállítás, legfelül a bekapcsoló kapcsolóval. -->
    <VerticalStackLayout Spacing="8">
        <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <Label Grid.Column="0" x:Name="TitleLabel" Text="" FontSize="15" FontAttributes="Bold" TextColor="White" />
            <Label Grid.Column="1" x:Name="ExpandIcon" Text="&#9660;" TextColor="White" FontSize="16" VerticalOptions="Center" />
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnHeaderTapped"/>
            </Grid.GestureRecognizers>
        </Grid>

        <VerticalStackLayout x:Name="DetailsPanel" Spacing="8" IsVisible="False">
            <HorizontalStackLayout Spacing="10">
                <Label Text="Bekapcsolva" TextColor="Gray" FontSize="13" VerticalOptions="Center" />
                <Switch x:Name="EnabledSwitch" />
            </HorizontalStackLayout>

            <Label x:Name="IntroLabel" Text="" TextColor="Gray" FontSize="12" />

            <VerticalStackLayout x:Name="SensorBox" Spacing="4" IsVisible="False">
                <Label Text="Hőmérő (forrás)" TextColor="Gray" FontSize="12" />
                <Picker x:Name="SensorPicker" TextColor="White" BackgroundColor="#3A3A3A">
                    <Picker.Items>
                        <x:String>1. hőmérő</x:String>
                        <x:String>2. hőmérő</x:String>
                    </Picker.Items>
                </Picker>
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="DaysBox" Spacing="4" IsVisible="False">
                <Label Text="Napok" TextColor="Gray" FontSize="12" />
                <HorizontalStackLayout x:Name="DaysRow" Spacing="4" />
            </VerticalStackLayout>

            <GraphicsView x:Name="DayGraph" HeightRequest="150" IsVisible="False" />

            <VerticalStackLayout x:Name="RowsContainer" Spacing="8" />

            <Border x:Name="AddBtn" BackgroundColor="#444444" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="38">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAddTapped"/></Border.GestureRecognizers>
                <Label x:Name="AddLabel" Text="+ Hozzáadás" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <Border BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="42">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSaveTapped"/></Border.GestureRecognizers>
                <Label x:Name="SaveLabel" Text="MENTÉS" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
