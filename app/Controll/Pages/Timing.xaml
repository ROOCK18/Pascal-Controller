                                <Entry Grid.Column="3" x:Name="Fan2LogicFreqCC" Text="30" Placeholder="CC Hz" Keyboard="Numeric" BackgroundColor="{StaticResource ControlGray}" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="38"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
