<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Controll.Pages"
             x:Class="Controll.Pages.Timing"
             BackgroundColor="{StaticResource GraphiteGray}">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <Border BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="44">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBackToControlClicked"/></Border.GestureRecognizers>
                <Label Text="← Vissza a vezérléshez" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <!-- ══════════════ VENTILÁTOR 1 ══════════════ -->
            <Border BackgroundColor="#2C2C2C" StrokeShape="RoundRectangle 12" Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Ventilátor 1" FontSize="18" FontAttributes="Bold" TextColor="White"/>
                        <Label Grid.Column="1" x:Name="Fan1ExpandIcon" Text="&#9660;" TextColor="White" FontSize="16" VerticalOptions="Center"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFan1HeaderTapped"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                    <VerticalStackLayout x:Name="Fan1DetailsPanel" Spacing="10" IsVisible="False">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Border x:Name="Fan1TimerTab" Grid.Column="0"
                                BackgroundColor="{StaticResource PrimaryRed}"
                                StrokeShape="RoundRectangle 8" Padding="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFan1TimerTabTapped"/>
                            </Border.GestureRecognizers>
                            <Label Text="⏱ Időzítő" TextColor="White" FontAttributes="Bold"
                                   HorizontalOptions="Center" Padding="0,10"/>
                        </Border>
                        <Border x:Name="Fan1ThermoTab" Grid.Column="1"
                                BackgroundColor="{StaticResource ControlGray}"
                                StrokeShape="RoundRectangle 8" Padding="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFan1ThermoTabTapped"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="Fan1ThermoTabLabel" Text="🌡 Termosztát" TextColor="White" FontAttributes="Bold"
                                   HorizontalOptions="Center" Padding="0,10"/>
                        </Border>
                    </Grid>

                    <!-- Fan1 Időzítő panel -->
                    <VerticalStackLayout x:Name="Fan1TimerPanel" Spacing="8">
                        <Label Text="Napok" TextColor="#AEAEB2" FontSize="12"/>
                        <HorizontalStackLayout Spacing="4" x:Name="Fan1DaysRow">
                            <Border x:Name="Fan1DayH"  BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 6" Padding="10,6"><Label Text="H"  TextColor="White" FontSize="13"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFan1DayTapped" CommandParameter="0"/></Border.GestureRecognizers></Border>
                            <Border x:Name="Fan1DayK"  BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 6" Padding="10,6"><Label Text="K"  TextColor="White" FontSize="13"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFan1DayTapped" CommandParameter="1"/></Border.GestureRecognizers></Border>
                            <Border x:Name="Fan1DaySz" BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 6" Padding="10,6"><Label Text="SZ" TextColor="White" FontSize="13"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFan1DayTapped" CommandParameter="2"/></Border.GestureRecognizers></Border>
                            <Border x:Name="Fan1DayCs" BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 6" Padding="10,6"><Label Text="CS" TextColor="White" FontSize="13"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFan1DayTapped" CommandParameter="3"/></Border.GestureRecognizers></Border>
                            <Border x:Name="Fan1DayP"  BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 6" Padding="10,6"><Label Text="P"  TextColor="White" FontSize="13"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFan1DayTapped" CommandParameter="4"/></Border.GestureRecognizers></Border>
                            <Border x:Name="Fan1DaySzo" BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 6" Padding="10,6"><Label Text="SZ" TextColor="White" FontSize="13"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFan1DayTapped" CommandParameter="5"/></Border.GestureRecognizers></Border>
                            <Border x:Name="Fan1DayV"  BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 6" Padding="10,6"><Label Text="V"  TextColor="White" FontSize="13"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFan1DayTapped" CommandParameter="6"/></Border.GestureRecognizers></Border>
                        </HorizontalStackLayout>

                        <Label Text="Időzítő slotok (max 5)" TextColor="#AEAEB2" FontSize="12"/>
                        <VerticalStackLayout x:Name="Fan1SlotsContainer" Spacing="6"/>

                        <Border x:Name="Fan1AddSlotBtn" BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="38">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFan1AddSlot"/></Border.GestureRecognizers>
                            <Label Text="+ Slot hozzáadása" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Border Grid.Column="0" BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="42">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFan1TimerSave"/></Border.GestureRecognizers>
                                <Label Text="MENTÉS" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 0,40,40,0" HeightRequest="42" WidthRequest="80">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFan1TimerDelete"/></Border.GestureRecognizers>
                                <Label Text="Törlés" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </Grid>
                        <Label x:Name="Fan1TimerStatus" Text="" TextColor="#AEAEB2" FontSize="11" HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- Fan1 Termosztát panel -->
                    <VerticalStackLayout x:Name="Fan1ThermoPanel" Spacing="10" IsVisible="False">
                        <Grid x:Name="Fan1ControlSourceRow" ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="False">
                            <Label Grid.Column="0" Text="Vezérlés forrása:" TextColor="#AEAEB2" FontSize="12" VerticalOptions="Center"/>
                            <Picker Grid.Column="1" x:Name="Fan1ControlSource" BackgroundColor="{StaticResource ControlGray}" TextColor="White"
                                    SelectedIndexChanged="OnFan1ControlSourceChanged">
                                <Picker.Items>
                                    <x:String>Hőmérséklet (görbe)</x:String>
                                    <x:String>Kapcsoló (K1)</x:String>
                                    <x:String>Kapcsoló + hőmérséklet</x:String>
                                </Picker.Items>
                            </Picker>
                        </Grid>
                        <VerticalStackLayout x:Name="Fan1ThermoNormal" Spacing="10">
                        <GraphicsView x:Name="Fan1CurveGraph" HeightRequest="150"/>
                        <Label FontSize="10" HorizontalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="■ " TextColor="#e74c3c"/><Span Text="Fordulatszám (%)   " TextColor="#AEAEB2"/>
                                    <Span Text="■ " TextColor="#e67e22"/><Span Text="PWM frekvencia (Hz)" TextColor="#AEAEB2"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="Pontok száma:" TextColor="#AEAEB2" FontSize="12" VerticalOptions="Center"/>
                            <Picker Grid.Column="1" x:Name="Fan1PointCount" BackgroundColor="{StaticResource ControlGray}" TextColor="White"
                                    SelectedIndexChanged="OnFan1PointCountChanged">
                                <Picker.Items>
                                    <x:String>1</x:String><x:String>2</x:String><x:String>3</x:String>
                                    <x:String>4</x:String><x:String>5</x:String>
                                </Picker.Items>
                            </Picker>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                            <Label Grid.Row="0" Grid.Column="0" Text="°C" TextColor="#AEAEB2" FontSize="10" HorizontalOptions="Center"/>
                            <Label Grid.Row="0" Grid.Column="1" Text="%" TextColor="#AEAEB2" FontSize="10" HorizontalOptions="Center"/>
                            <Label Grid.Row="0" Grid.Column="2" Text="Hz" TextColor="#AEAEB2" FontSize="10" HorizontalOptions="Center"/>
                            <Entry Grid.Row="1" Grid.Column="0" x:Name="Fan1P1T"    Text="10"  Placeholder="°C" Keyboard="Numeric" BackgroundColor="{StaticResource ControlGray}" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="40" TextChanged="OnFan1ThermoChanged"/>
                            <Entry Grid.Row="1" Grid.Column="1" x:Name="Fan1P1Pct"  Text="0"   Placeholder="%"  Keyboard="Numeric" BackgroundColor="{StaticResource ControlGray}" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="40" TextChanged="OnFan1ThermoChanged"/>
                            <Entry Grid.Row="1" Grid.Column="2" x:Name="Fan1P1Freq" Text="30"  Placeholder="Hz" Keyboard="Numeric" BackgroundColor="{StaticResource ControlGray}" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="40" TextChanged="OnFan1ThermoChanged"/>
                            <Entry Grid.Row="2" Grid.Column="0" x:Name="Fan1P2T"    Text="20"  Placeholder="°C" Keyboard="Numeric" BackgroundColor="{StaticResource ControlGray}" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="40" TextChanged="OnFan1ThermoChanged"/>
                            <Entry Grid.Row="2" Grid.Column="1" x:Name="Fan1P2Pct"  Text="25"  Placeholder="%"  Keyboard="Numeric" BackgroundColor="{StaticResource ControlGray}" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="40" TextChanged="OnFan1ThermoChanged"/>
                            <Entry Grid.Row="2" Grid.Column="2" x:Name="Fan1P2Freq" Text="30"  Placeholder="Hz" Keyboard="Numeric" BackgroundColor="{StaticResource ControlGray}" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="40" TextChanged="OnFan1ThermoChanged"/>
                            <Entry Grid.Row="3" Grid.Column="0" x:Name="Fan1P3T"    Text="30"  Placeholder="°C" Keyboard="Numeric" BackgroundColor="{StaticResource ControlGray}" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="40" TextChanged="OnFan1ThermoChanged"/>
                            <Entry Grid.Row="3" Grid.Column="1" x:Name="Fan1P3Pct"  Text="50"  Placeholder="%"  Keyboard="Numeric" BackgroundColor="{StaticResource ControlGray}" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="40" TextChanged="OnFan1ThermoChanged"/>
                            <Entry Grid.Row="3" Grid.Column="2" x:Name="Fan1P3Freq" Text="30"  Placeholder="Hz" Keyboard="Numeric" BackgroundColor="{StaticResource ControlGray}" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="40" TextChanged="OnFan1ThermoChanged"/>
                            <Entry Grid.Row="4" Grid.Column="0" x:Name="Fan1P4T"    Text="40"  Placeholder="°C" Keyboard="Numeric" BackgroundColor="{StaticResource ControlGray}" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="40" TextChanged="OnFan1ThermoChanged"/>
                            <Entry Grid.Row="4" Grid.Column="1" x:Name="Fan1P4Pct"  Text="75"  Placeholder="%"  Keyboard="Numeric" BackgroundColor="{StaticResource ControlGray}" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="40" TextChanged="OnFan1ThermoChanged"/>
                            <Entry Grid.Row="4" Grid.Column="2" x:Name="Fan1P4Freq" Text="30"  Placeholder="Hz" Keyboard="Numeric" BackgroundColor="{StaticResource ControlGray}" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="40" TextChanged="OnFan1ThermoChanged"/>
                            <Entry Grid.Row="5" Grid.Column="0" x:Name="Fan1P5T"    Text="50"  Placeholder="°C" Keyboard="Numeric" BackgroundColor="{StaticResource ControlGray}" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="40" TextChanged="OnFan1ThermoChanged"/>
                            <Entry Grid.Row="5" Grid.Column="1" x:Name="Fan1P5Pct"  Text="100" Placeholder="%"  Keyboard="Numeric" BackgroundColor="{StaticResource ControlGray}" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="40" TextChanged="OnFan1ThermoChanged"/>
                            <Entry Grid.Row="5" Grid.Column="2" x:Name="Fan1P5Freq" Text="30"  Placeholder="Hz" Keyboard="Numeric" BackgroundColor="{StaticResource ControlGray}" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="40" TextChanged="OnFan1ThermoChanged"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Érzékelő" TextColor="#AEAEB2" FontSize="11"/>
                                <Picker x:Name="Fan1ThermoSensor"
                                        BackgroundColor="{StaticResource ControlGray}" TextColor="White"
                                        SelectedIndexChanged="OnFan1ThermoChanged">
                                    <Picker.Items><x:String>NTC1 (T1)</x:String><x:String>NTC2 (T2)</x:String></Picker.Items>
                                </Picker>
                            </VerticalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="#1A1A1A" StrokeShape="RoundRectangle 8" Padding="12">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="Aktuális → számított" TextColor="#AEAEB2" FontSize="10"/>
                                    <Label x:Name="Fan1ThermoPreview" Text="-- °C  →  -- %"
                                           TextColor="{StaticResource PrimaryRed}" FontSize="13" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Border Grid.Column="0" BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="42">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFan1ThermoSave"/></Border.GestureRecognizers>
                                <Label Text="TERMOSZTÁT MENTÉSE" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 0,40,40,0" HeightRequest="42" WidthRequest="80">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFan1ThermoDelete"/></Border.GestureRecognizers>
                                <Label Text="Törlés" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </Grid>
                        <Label x:Name="Fan1ThermoStatus" Text="" TextColor="#AEAEB2" FontSize="11" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <!-- Fan1 Kapcsoló-logika (csak "2 kapcsoló" módban látszik) -->
                        <VerticalStackLayout x:Name="Fan1LogicSection" Spacing="10" IsVisible="False">
                            <Label x:Name="Fan1LogicIntro" Text="Add meg K1/K2 minden állapot-kombinációjához a ventilátor fordulatszámát (%)" TextColor="#AEAEB2" FontSize="11"/>
                            <VerticalStackLayout x:Name="Fan1LogicThresholdSection" Spacing="4" IsVisible="False">
                                <Label Text="Hőmérséklet küszöb (°C) - ez választja el az 'Alacsony'/'Magas' esetet" TextColor="#AEAEB2" FontSize="11"/>
                                <Entry x:Name="Fan1LogicThreshold" Text="30" Keyboard="Numeric"
                                       BackgroundColor="{StaticResource ControlGray}" TextColor="White"
                                       HorizontalTextAlignment="Center" HeightRequest="40"/>
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                                <Label Grid.Row="0" Grid.Column="0" x:Name="Fan1LogicRow1" Text="K1: Nyitott · K2: Nyitott" TextColor="White" FontSize="13" VerticalOptions="Center"/>
                                <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                                    <Picker x:Name="Fan1LogicOOMode" WidthRequest="150" BackgroundColor="{StaticResource ControlGray}" TextColor="White" SelectedIndexChanged="OnFan1LogicOOModeChanged">
                                        <Picker.Items>
                                            <x:String>Görbe szerint</x:String>
                                            <x:String>Kikapcsolva</x:String>
                                            <x:String>Bekapcsolva</x:String>
                                            <x:String>Egyéni %</x:String>
                                        </Picker.Items>
                                    </Picker>
                                    <Entry x:Name="Fan1LogicOO" Text="50" Placeholder="%" Keyboard="Numeric" WidthRequest="150" BackgroundColor="{StaticResource ControlGray}" TextColor="White" HorizontalTextAlignment="Center" IsVisible="False"/>
                                </VerticalStackLayout>
                                <Label Grid.Row="1" Grid.Column="0" x:Name="Fan1LogicRow2" Text="K1: Nyitott · K2: Zárt" TextColor="White" FontSize="13" VerticalOptions="Center"/>
                                <Entry Grid.Row="1" Grid.Column="1" x:Name="Fan1LogicOC" Text="50" Placeholder="%" Keyboard="Numeric" WidthRequest="70" BackgroundColor="{StaticResource ControlGray}" TextColor="White" HorizontalTextAlignment="Center"/>
                                <Label Grid.Row="2" Grid.Column="0" x:Name="Fan1LogicRow3" Text="K1: Zárt · K2: Nyitott" TextColor="White" FontSize="13" VerticalOptions="Center"/>
                                <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="4">
                                    <Picker x:Name="Fan1LogicCOMode" WidthRequest="150" BackgroundColor="{StaticResource ControlGray}" TextColor="White" SelectedIndexChanged="OnFan1LogicCOModeChanged">
                                        <Picker.Items>
                                            <x:String>Görbe szerint</x:String>
                                            <x:String>Kikapcsolva</x:String>
                                            <x:String>Bekapcsolva</x:String>
                                            <x:String>Egyéni %</x:String>
                                        </Picker.Items>
                                    </Picker>
                                    <Entry x:Name="Fan1LogicCO" Text="50" Placeholder="%" Keyboard="Numeric" WidthRequest="150" BackgroundColor="{StaticResource ControlGray}" TextColor="White" HorizontalTextAlignment="Center" IsVisible="False"/>
                                </VerticalStackLayout>
                                <Label Grid.Row="3" Grid.Column="0" x:Name="Fan1LogicRow4" Text="K1: Zárt · K2: Zárt" TextColor="White" FontSize="13" VerticalOptions="Center"/>
                                <Entry Grid.Row="3" Grid.Column="1" x:Name="Fan1LogicCC" Text="100" Placeholder="%" Keyboard="Numeric" WidthRequest="70" BackgroundColor="{StaticResource ControlGray}" TextColor="White" HorizontalTextAlignment="Center"/>
                            </Grid>
                            <Label Text="Frekvencia állapotonként (Hz)" TextColor="#AEAEB2" FontSize="11"/>
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                <Entry Grid.Column="0" x:Name="Fan1LogicFreqOO" Text="30" Placeholder="OO Hz" Keyboard="Numeric" BackgroundColor="{StaticResource ControlGray}" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="38"/>
                                <Entry Grid.Column="1" x:Name="Fan1LogicFreqOC" Text="30" Placeholder="OC Hz" Keyboard="Numeric" BackgroundColor="{StaticResource ControlGray}" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="38"/>
                                <Entry Grid.Column="2" x:Name="Fan1LogicFreqCO" Text="30" Placeholder="CO Hz" Keyboard="Numeric" BackgroundColor="{StaticResource ControlGray}" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="38"/>
                                <Entry Grid.Column="3" x:Name="Fan1LogicFreqCC" Text="30" Placeholder="CC Hz" Keyboard="Numeric" BackgroundColor="{StaticResource ControlGray}" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="38"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Border Grid.Column="0" BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="42">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFan1LogicSave"/></Border.GestureRecognizers>
                                    <Label Text="LOGIKA MENTÉSE" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Border Grid.Column="1" BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 0,40,40,0" HeightRequest="42" WidthRequest="80">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFan1LogicDelete"/></Border.GestureRecognizers>
                                    <Label Text="Törlés" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                            </Grid>
                            <Label x:Name="Fan1LogicStatus" Text="" TextColor="#AEAEB2" FontSize="11" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                    <pages:ProxChannelView x:Name="ProxF1View" ChannelKey="F1" Kind="Fan" />
                    <pages:AlertChannelView x:Name="AlertF1View" ChannelKey="F1" />
                </VerticalStackLayout>
                    </VerticalStackLayout>
            </Border>

            <!-- ══════════════ VENTILÁTOR 2 ══════════════ -->
            <Border BackgroundColor="#2C2C2C" StrokeShape="RoundRectangle 12" Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Ventilátor 2" FontSize="18" FontAttributes="Bold" TextColor="White"/>
                        <Label Grid.Column="1" x:Name="Fan2ExpandIcon" Text="&#9660;" TextColor="White" FontSize="16" VerticalOptions="Center"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFan2HeaderTapped"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                    <VerticalStackLayout x:Name="Fan2DetailsPanel" Spacing="10" IsVisible="False">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Border x:Name="Fan2TimerTab" Grid.Column="0"
                                BackgroundColor="{StaticResource PrimaryRed}"
                                StrokeShape="RoundRectangle 8" Padding="0">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFan2TimerTabTapped"/></Border.GestureRecognizers>
                            <Label Text="⏱ Időzítő" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" Padding="0,10"/>
                        </Border>
                        <Border x:Name="Fan2ThermoTab" Grid.Column="1"
                                BackgroundColor="{StaticResource ControlGray}"
                                StrokeShape="RoundRectangle 8" Padding="0">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFan2ThermoTabTapped"/></Border.GestureRecognizers>
                            <Label x:Name="Fan2ThermoTabLabel" Text="🌡 Termosztát" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" Padding="0,10"/>
                        </Border>
                    </Grid>

                    <VerticalStackLayout x:Name="Fan2TimerPanel" Spacing="8">
                        <Label Text="Napok" TextColor="#AEAEB2" FontSize="12"/>
                        <HorizontalStackLayout Spacing="4">
                            <Border x:Name="Fan2DayH"  BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 6" Padding="10,6"><Label Text="H"  TextColor="White" FontSize="13"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFan2DayTapped" CommandParameter="0"/></Border.GestureRecognizers></Border>
                            <Border x:Name="Fan2DayK"  BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 6" Padding="10,6"><Label Text="K"  TextColor="White" FontSize="13"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFan2DayTapped" CommandParameter="1"/></Border.GestureRecognizers></Border>
                            <Border x:Name="Fan2DaySz" BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 6" Padding="10,6"><Label Text="SZ" TextColor="White" FontSize="13"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFan2DayTapped" CommandParameter="2"/></Border.GestureRecognizers></Border>
                            <Border x:Name="Fan2DayCs" BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 6" Padding="10,6"><Label Text="CS" TextColor="White" FontSize="13"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFan2DayTapped" CommandParameter="3"/></Border.GestureRecognizers></Border>
                            <Border x:Name="Fan2DayP"  BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 6" Padding="10,6"><Label Text="P"  TextColor="White" FontSize="13"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFan2DayTapped" CommandParameter="4"/></Border.GestureRecognizers></Border>
                            <Border x:Name="Fan2DaySzo" BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 6" Padding="10,6"><Label Text="SZ" TextColor="White" FontSize="13"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFan2DayTapped" CommandParameter="5"/></Border.GestureRecognizers></Border>
                            <Border x:Name="Fan2DayV"  BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 6" Padding="10,6"><Label Text="V"  TextColor="White" FontSize="13"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFan2DayTapped" CommandParameter="6"/></Border.GestureRecognizers></Border>
                        </HorizontalStackLayout>
                        <Label Text="Időzítő slotok (max 5)" TextColor="#AEAEB2" FontSize="12"/>
                        <VerticalStackLayout x:Name="Fan2SlotsContainer" Spacing="6"/>
                        <Border x:Name="Fan2AddSlotBtn" BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="38">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFan2AddSlot"/></Border.GestureRecognizers>
                            <Label Text="+ Slot hozzáadása" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Border Grid.Column="0" BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="42">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFan2TimerSave"/></Border.GestureRecognizers>
                                <Label Text="MENTÉS" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 0,40,40,0" HeightRequest="42" WidthRequest="80">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFan2TimerDelete"/></Border.GestureRecognizers>
