                            </Border>
                        </Grid>
                        <Label x:Name="Fan2ThermoStatus" Text="" TextColor="#AEAEB2" FontSize="11" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <!-- Fan2 Kapcsoló-logika (csak "2 kapcsoló" módban látszik) -->
