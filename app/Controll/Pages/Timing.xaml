                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                                <Label Grid.Row="0" Grid.Column="0" x:Name="Relay1LogicRow1" Text="K1: Nyitott · K2: Nyitott" TextColor="White" FontSize="13" VerticalOptions="Center"/>
                                <Picker Grid.Row="0" Grid.Column="1" x:Name="Relay1LogicOO" WidthRequest="150" BackgroundColor="{StaticResource ControlGray}" TextColor="White"><Picker.Items><x:String>KI</x:String><x:String>BE</x:String><x:String>Termosztátot követi</x:String></Picker.Items></Picker>
                                <Label Grid.Row="1" Grid.Column="0" x:Name="Relay1LogicRow2" Text="K1: Nyitott · K2: Zárt" TextColor="White" FontSize="13" VerticalOptions="Center"/>
                                <Picker Grid.Row="1" Grid.Column="1" x:Name="Relay1LogicOC" WidthRequest="150" BackgroundColor="{StaticResource ControlGray}" TextColor="White"><Picker.Items><x:String>KI</x:String><x:String>BE</x:String><x:String>Termosztátot követi</x:String></Picker.Items></Picker>
                                <Label Grid.Row="2" Grid.Column="0" x:Name="Relay1LogicRow3" Text="K1: Zárt · K2: Nyitott" TextColor="White" FontSize="13" VerticalOptions="Center"/>
                                <Picker Grid.Row="2" Grid.Column="1" x:Name="Relay1LogicCO" WidthRequest="150" BackgroundColor="{StaticResource ControlGray}" TextColor="White"><Picker.Items><x:String>KI</x:String><x:String>BE</x:String><x:String>Termosztátot követi</x:String></Picker.Items></Picker>
                                <Label Grid.Row="3" Grid.Column="0" x:Name="Relay1LogicRow4" Text="K1: Zárt · K2: Zárt" TextColor="White" FontSize="13" VerticalOptions="Center"/>
                                <Picker Grid.Row="3" Grid.Column="1" x:Name="Relay1LogicCC" WidthRequest="150" BackgroundColor="{StaticResource ControlGray}" TextColor="White"><Picker.Items><x:String>KI</x:String><x:String>BE</x:String><x:String>Termosztátot követi</x:String></Picker.Items></Picker>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Border Grid.Column="0" BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="42">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRelay1LogicSave"/></Border.GestureRecognizers>
                                    <Label Text="LOGIKA MENTÉSE" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Border Grid.Column="1" BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 0,40,40,0" HeightRequest="42" WidthRequest="80">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRelay1LogicDelete"/></Border.GestureRecognizers>
                                    <Label Text="Törlés" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                            </Grid>
                            <Label x:Name="Relay1LogicStatus" Text="" TextColor="#AEAEB2" FontSize="11" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- ══════════ KAPUZÁS - al-lenyíló a Relé 1 kártyán belül ══════════ -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                        <Label Grid.Column="0" Text="Kapuzás" FontSize="15" FontAttributes="Bold" TextColor="White"/>
                        <Label Grid.Column="1" x:Name="Relay1HoldExpandIcon" Text="&#9660;" TextColor="White" FontSize="16" VerticalOptions="Center"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRelay1HoldHeaderTapped"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                    <VerticalStackLayout x:Name="Relay1HoldDetailsPanel" Spacing="10" IsVisible="False">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Bekapcsolva" TextColor="#AEAEB2" FontSize="13" VerticalOptions="Center"/>
                            <Switch x:Name="Relay1HoldEnabled"/>
                        </HorizontalStackLayout>
                        <Label Text="Mód" TextColor="#AEAEB2" FontSize="12"/>
                        <Picker x:Name="Relay1HoldMode" BackgroundColor="{StaticResource ControlGray}" TextColor="White">
                            <Picker.Items><x:String>Fix idő</x:String><x:String>Max idő</x:String></Picker.Items>
                        </Picker>
                        <Label Text="Időtartam (mp)" TextColor="#AEAEB2" FontSize="12"/>
                        <Entry x:Name="Relay1HoldDuration" Text="30" Keyboard="Numeric" BackgroundColor="{StaticResource ControlGray}" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="40"/>
                        <Label Text="Zárolás módja" TextColor="#AEAEB2" FontSize="12"/>
                        <Picker x:Name="Relay1HoldLockMode" BackgroundColor="{StaticResource ControlGray}" TextColor="White">
                            <Picker.Items><x:String>Nincs</x:String><x:String>Idő alapú</x:String><x:String>Jelváltásig</x:String></Picker.Items>
                        </Picker>
                        <Label Text="Zárolás ideje (mp)" TextColor="#AEAEB2" FontSize="12"/>
                        <Entry x:Name="Relay1HoldLockDuration" Text="300" Keyboard="Numeric" BackgroundColor="{StaticResource ControlGray}" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="40"/>
                        <Label Text="Állapot (melyik irányra vonatkozzon)" TextColor="#AEAEB2" FontSize="12"/>
                        <Picker x:Name="Relay1HoldState" BackgroundColor="{StaticResource ControlGray}" TextColor="White">
                            <Picker.Items><x:String>BE</x:String><x:String>KI</x:String><x:String>MIND</x:String></Picker.Items>
                        </Picker>
                        <Border BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="42">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRelay1HoldSave"/></Border.GestureRecognizers>
                            <Label Text="MENTÉS" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label x:Name="Relay1HoldStatus" Text="" TextColor="#AEAEB2" FontSize="11" HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <pages:ProxChannelView x:Name="ProxR1View" ChannelKey="R1" Kind="Relay" />
                    <pages:AlertChannelView x:Name="AlertR1View" ChannelKey="R1" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ══════════════ RELÉ 2 ══════════════ -->
            <Border BackgroundColor="#2C2C2C" StrokeShape="RoundRectangle 12" Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Relé 2" FontSize="18" FontAttributes="Bold" TextColor="White"/>
                        <Label Grid.Column="1" x:Name="Relay2ExpandIcon" Text="&#9660;" TextColor="White" FontSize="16" VerticalOptions="Center"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRelay2HeaderTapped"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                    <VerticalStackLayout x:Name="Relay2DetailsPanel" Spacing="10" IsVisible="False">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Border x:Name="Relay2TimerTab" Grid.Column="0"
                                BackgroundColor="{StaticResource PrimaryRed}"
                                StrokeShape="RoundRectangle 8" Padding="0">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRelay2TimerTabTapped"/></Border.GestureRecognizers>
                            <Label Text="⏱ Időzítő" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" Padding="0,10"/>
                        </Border>
                        <Border x:Name="Relay2ThermoTab" Grid.Column="1"
                                BackgroundColor="{StaticResource ControlGray}"
                                StrokeShape="RoundRectangle 8" Padding="0">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRelay2ThermoTabTapped"/></Border.GestureRecognizers>
                            <Label x:Name="Relay2ThermoTabLabel" Text="🌡 Termosztát" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" Padding="0,10"/>
                        </Border>
                    </Grid>

                    <VerticalStackLayout x:Name="Relay2TimerPanel" Spacing="8">
                        <Label Text="Napok" TextColor="#AEAEB2" FontSize="12"/>
                        <HorizontalStackLayout Spacing="4">
                            <Border x:Name="Relay2DayH"  BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 6" Padding="10,6"><Label Text="H"  TextColor="White" FontSize="13"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRelay2DayTapped" CommandParameter="0"/></Border.GestureRecognizers></Border>
                            <Border x:Name="Relay2DayK"  BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 6" Padding="10,6"><Label Text="K"  TextColor="White" FontSize="13"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRelay2DayTapped" CommandParameter="1"/></Border.GestureRecognizers></Border>
                            <Border x:Name="Relay2DaySz" BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 6" Padding="10,6"><Label Text="SZ" TextColor="White" FontSize="13"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRelay2DayTapped" CommandParameter="2"/></Border.GestureRecognizers></Border>
                            <Border x:Name="Relay2DayCs" BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 6" Padding="10,6"><Label Text="CS" TextColor="White" FontSize="13"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRelay2DayTapped" CommandParameter="3"/></Border.GestureRecognizers></Border>
                            <Border x:Name="Relay2DayP"  BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 6" Padding="10,6"><Label Text="P"  TextColor="White" FontSize="13"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRelay2DayTapped" CommandParameter="4"/></Border.GestureRecognizers></Border>
                            <Border x:Name="Relay2DaySzo" BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 6" Padding="10,6"><Label Text="SZ" TextColor="White" FontSize="13"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRelay2DayTapped" CommandParameter="5"/></Border.GestureRecognizers></Border>
                            <Border x:Name="Relay2DayV"  BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 6" Padding="10,6"><Label Text="V"  TextColor="White" FontSize="13"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRelay2DayTapped" CommandParameter="6"/></Border.GestureRecognizers></Border>
                        </HorizontalStackLayout>
                        <Label Text="Időzítő slotok — be/ki esemény (max 5)" TextColor="#AEAEB2" FontSize="12"/>
                        <VerticalStackLayout x:Name="Relay2SlotsContainer" Spacing="6"/>
                        <Border x:Name="Relay2AddSlotBtn" BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="38">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRelay2AddSlot"/></Border.GestureRecognizers>
                            <Label Text="+ Slot hozzáadása" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Border Grid.Column="0" BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="42">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRelay2TimerSave"/></Border.GestureRecognizers>
                                <Label Text="MENTÉS" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 0,40,40,0" HeightRequest="42" WidthRequest="80">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRelay2TimerDelete"/></Border.GestureRecognizers>
                                <Label Text="Törlés" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </Grid>
                        <Label x:Name="Relay2TimerStatus" Text="" TextColor="#AEAEB2" FontSize="11" HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="Relay2ThermoPanel" Spacing="10" IsVisible="False">
                        <Grid x:Name="Relay2ControlSourceRow" ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="False">
                            <Label Grid.Column="0" Text="Vezérlés forrása:" TextColor="#AEAEB2" FontSize="12" VerticalOptions="Center"/>
                            <Picker Grid.Column="1" x:Name="Relay2ControlSource" BackgroundColor="{StaticResource ControlGray}" TextColor="White"
                                    SelectedIndexChanged="OnRelay2ControlSourceChanged">
                                <Picker.Items>
                                    <x:String>Hőmérséklet</x:String>
                                    <x:String>Kapcsoló (K1)</x:String>
                                    <x:String>Kapcsoló + hőmérséklet</x:String>
                                </Picker.Items>
                            </Picker>
                        </Grid>
                        <VerticalStackLayout x:Name="Relay2ThermoNormal" Spacing="10">
                        <Border BackgroundColor="#1A1A1A" StrokeShape="RoundRectangle 8" Padding="12">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Hiszterézis — relé nem csapkod a küszöb körül" TextColor="#AEAEB2" FontSize="11"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label x:Name="Relay2OnLabel" Text="Bekapcsol (°C)" TextColor="#AEAEB2" FontSize="11"/>
                                        <Entry x:Name="Relay2TOn" Text="30" Keyboard="Numeric"
                                               BackgroundColor="{StaticResource ControlGray}" TextColor="White"
                                               HorizontalTextAlignment="Center" HeightRequest="44"
                                               TextChanged="OnRelay2ThermoChanged"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label x:Name="Relay2OffLabel" Text="Kikapcsol (°C)" TextColor="#AEAEB2" FontSize="11"/>
                                        <Entry x:Name="Relay2TOff" Text="25" Keyboard="Numeric"
                                               BackgroundColor="{StaticResource ControlGray}" TextColor="White"
                                               HorizontalTextAlignment="Center" HeightRequest="44"
                                               TextChanged="OnRelay2ThermoChanged"/>
                                    </VerticalStackLayout>
                                </Grid>
                                <GraphicsView x:Name="Relay2ThermoGraph" HeightRequest="90"/>
                            </VerticalStackLayout>
                        </Border>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Érzékelő" TextColor="#AEAEB2" FontSize="11"/>
                                <Picker x:Name="Relay2ThermoSensor" SelectedIndexChanged="OnRelay2ThermoChanged" BackgroundColor="{StaticResource ControlGray}" TextColor="White">
                                    <Picker.Items><x:String>NTC1 (T1)</x:String><x:String>NTC2 (T2)</x:String></Picker.Items>
                                </Picker>
                            </VerticalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="#1A1A1A" StrokeShape="RoundRectangle 8" Padding="12">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label x:Name="Relay2CurrentLabel" Text="Aktuális hőmérséklet" TextColor="#AEAEB2" FontSize="10"/>
                                    <Label x:Name="Relay2CurrentTemp" Text="-- °C"
                                           TextColor="{StaticResource PrimaryRed}" FontSize="18" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Border Grid.Column="0" BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="42">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRelay2ThermoSave"/></Border.GestureRecognizers>
                                <Label Text="TERMOSZTÁT MENTÉSE" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 0,40,40,0" HeightRequest="42" WidthRequest="80">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRelay2ThermoDelete"/></Border.GestureRecognizers>
                                <Label Text="Törlés" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </Grid>
                        <Label x:Name="Relay2ThermoStatus" Text="" TextColor="#AEAEB2" FontSize="11" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <!-- Relay2 Kapcsoló-logika (csak "2 kapcsoló" módban látszik) -->
                        <VerticalStackLayout x:Name="Relay2LogicSection" Spacing="10" IsVisible="False">
                            <Label x:Name="Relay2LogicIntro" Text="Add meg K1/K2 minden állapot-kombinációjához, hogy a relé húzzon-e" TextColor="#AEAEB2" FontSize="11"/>
                            <VerticalStackLayout x:Name="Relay2LogicThresholdSection" Spacing="4" IsVisible="False">
                                <Label Text="Hőmérséklet küszöb (°C) - ez választja el az 'Alacsony'/'Magas' esetet" TextColor="#AEAEB2" FontSize="11"/>
                                <Entry x:Name="Relay2LogicThreshold" Text="30" Keyboard="Numeric"
                                       BackgroundColor="{StaticResource ControlGray}" TextColor="White"
                                       HorizontalTextAlignment="Center" HeightRequest="40"/>
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                                <Label Grid.Row="0" Grid.Column="0" x:Name="Relay2LogicRow1" Text="K1: Nyitott · K2: Nyitott" TextColor="White" FontSize="13" VerticalOptions="Center"/>
                                <Picker Grid.Row="0" Grid.Column="1" x:Name="Relay2LogicOO" WidthRequest="150" BackgroundColor="{StaticResource ControlGray}" TextColor="White"><Picker.Items><x:String>KI</x:String><x:String>BE</x:String><x:String>Termosztátot követi</x:String></Picker.Items></Picker>
                                <Label Grid.Row="1" Grid.Column="0" x:Name="Relay2LogicRow2" Text="K1: Nyitott · K2: Zárt" TextColor="White" FontSize="13" VerticalOptions="Center"/>
                                <Picker Grid.Row="1" Grid.Column="1" x:Name="Relay2LogicOC" WidthRequest="150" BackgroundColor="{StaticResource ControlGray}" TextColor="White"><Picker.Items><x:String>KI</x:String><x:String>BE</x:String><x:String>Termosztátot követi</x:String></Picker.Items></Picker>
                                <Label Grid.Row="2" Grid.Column="0" x:Name="Relay2LogicRow3" Text="K1: Zárt · K2: Nyitott" TextColor="White" FontSize="13" VerticalOptions="Center"/>
                                <Picker Grid.Row="2" Grid.Column="1" x:Name="Relay2LogicCO" WidthRequest="150" BackgroundColor="{StaticResource ControlGray}" TextColor="White"><Picker.Items><x:String>KI</x:String><x:String>BE</x:String><x:String>Termosztátot követi</x:String></Picker.Items></Picker>
                                <Label Grid.Row="3" Grid.Column="0" x:Name="Relay2LogicRow4" Text="K1: Zárt · K2: Zárt" TextColor="White" FontSize="13" VerticalOptions="Center"/>
                                <Picker Grid.Row="3" Grid.Column="1" x:Name="Relay2LogicCC" WidthRequest="150" BackgroundColor="{StaticResource ControlGray}" TextColor="White"><Picker.Items><x:String>KI</x:String><x:String>BE</x:String><x:String>Termosztátot követi</x:String></Picker.Items></Picker>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Border Grid.Column="0" BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="42">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRelay2LogicSave"/></Border.GestureRecognizers>
                                    <Label Text="LOGIKA MENTÉSE" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Border Grid.Column="1" BackgroundColor="{StaticResource ControlGray}" StrokeShape="RoundRectangle 0,40,40,0" HeightRequest="42" WidthRequest="80">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRelay2LogicDelete"/></Border.GestureRecognizers>
                                    <Label Text="Törlés" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                            </Grid>
                            <Label x:Name="Relay2LogicStatus" Text="" TextColor="#AEAEB2" FontSize="11" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- ══════════ KAPUZÁS - al-lenyíló a Relé 2 kártyán belül ══════════ -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                        <Label Grid.Column="0" Text="Kapuzás" FontSize="15" FontAttributes="Bold" TextColor="White"/>
                        <Label Grid.Column="1" x:Name="Relay2HoldExpandIcon" Text="&#9660;" TextColor="White" FontSize="16" VerticalOptions="Center"/>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRelay2HoldHeaderTapped"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                    <VerticalStackLayout x:Name="Relay2HoldDetailsPanel" Spacing="10" IsVisible="False">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Bekapcsolva" TextColor="#AEAEB2" FontSize="13" VerticalOptions="Center"/>
                            <Switch x:Name="Relay2HoldEnabled"/>
                        </HorizontalStackLayout>
                        <Label Text="Mód" TextColor="#AEAEB2" FontSize="12"/>
                        <Picker x:Name="Relay2HoldMode" BackgroundColor="{StaticResource ControlGray}" TextColor="White">
                            <Picker.Items><x:String>Fix idő</x:String><x:String>Max idő</x:String></Picker.Items>
                        </Picker>
                        <Label Text="Időtartam (mp)" TextColor="#AEAEB2" FontSize="12"/>
                        <Entry x:Name="Relay2HoldDuration" Text="30" Keyboard="Numeric" BackgroundColor="{StaticResource ControlGray}" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="40"/>
                        <Label Text="Zárolás módja" TextColor="#AEAEB2" FontSize="12"/>
                        <Picker x:Name="Relay2HoldLockMode" BackgroundColor="{StaticResource ControlGray}" TextColor="White">
                            <Picker.Items><x:String>Nincs</x:String><x:String>Idő alapú</x:String><x:String>Jelváltásig</x:String></Picker.Items>
                        </Picker>
                        <Label Text="Zárolás ideje (mp)" TextColor="#AEAEB2" FontSize="12"/>
                        <Entry x:Name="Relay2HoldLockDuration" Text="300" Keyboard="Numeric" BackgroundColor="{StaticResource ControlGray}" TextColor="White" HorizontalTextAlignment="Center" HeightRequest="40"/>
                        <Label Text="Állapot (melyik irányra vonatkozzon)" TextColor="#AEAEB2" FontSize="12"/>
                        <Picker x:Name="Relay2HoldState" BackgroundColor="{StaticResource ControlGray}" TextColor="White">
                            <Picker.Items><x:String>BE</x:String><x:String>KI</x:String><x:String>MIND</x:String></Picker.Items>
                        </Picker>
                        <Border BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="42">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRelay2HoldSave"/></Border.GestureRecognizers>
                            <Label Text="MENTÉS" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label x:Name="Relay2HoldStatus" Text="" TextColor="#AEAEB2" FontSize="11" HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <pages:ProxChannelView x:Name="ProxR2View" ChannelKey="R2" Kind="Relay" />
                    <pages:AlertChannelView x:Name="AlertR2View" ChannelKey="R2" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
