                                <Label Grid.Row="1" Grid.Column="0" x:Name="Fan2LogicRow2" Text="K1: Nyitott · K2: Zárt" TextColor="White" FontSize="13" VerticalOptions="Center"/>
                                <Entry Grid.Row="1" Grid.Column="1" x:Name="Fan2LogicOC" Text="50" Placeholder="%" Keyboard="Numeric" WidthRequest="70" BackgroundColor="#3A3A3A" TextColor="White" HorizontalTextAlignment="Center"/>
