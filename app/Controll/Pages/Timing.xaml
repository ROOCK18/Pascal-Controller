                                       HorizontalTextAlignment="Center" HeightRequest="40"/>
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                                <Label Grid.Row="0" Grid.Column="0" x:Name="Relay1LogicRow1" Text="K1: Nyitott · K2: Nyitott" TextColor="White" FontSize="13" VerticalOptions="Center"/>
                                <Switch Grid.Row="0" Grid.Column="1" x:Name="Relay1LogicOO"/>
                                <Label Grid.Row="1" Grid.Column="0" x:Name="Relay1LogicRow2" Text="K1: Nyitott · K2: Zárt" TextColor="White" FontSize="13" VerticalOptions="Center"/>
                                <Switch Grid.Row="1" Grid.Column="1" x:Name="Relay1LogicOC"/>
                                <Label Grid.Row="2" Grid.Column="0" x:Name="Relay1LogicRow3" Text="K1: Zárt · K2: Nyitott" TextColor="White" FontSize="13" VerticalOptions="Center"/>
