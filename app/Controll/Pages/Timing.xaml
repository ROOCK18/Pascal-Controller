                                               BackgroundColor="#3A3A3A" TextColor="White"
                                               HorizontalTextAlignment="Center" HeightRequest="44"
                                               TextChanged="OnRelay1ThermoChanged"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label x:Name="Relay1OffLabel" Text="Kikapcsol (°C)" TextColor="Gray" FontSize="11"/>
