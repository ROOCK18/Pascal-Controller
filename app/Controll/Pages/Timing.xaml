                            <Border x:Name="Relay2DaySz" BackgroundColor="#444" StrokeShape="RoundRectangle 6" Padding="10,6"><Label Text="SZ" TextColor="White" FontSize="13"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRelay2DayTapped" CommandParameter="2"/></Border.GestureRecognizers></Border>
