                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="Relay1ThermoPanel" Spacing="10" IsVisible="False">
                        <Grid x:Name="Relay1ControlSourceRow" ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="False">
                            <Label Grid.Column="0" Text="Vezérlés forrása:" TextColor="Gray" FontSize="12" VerticalOptions="Center"/>
                            <Picker Grid.Column="1" x:Name="Relay1ControlSource" BackgroundColor="#3A3A3A" TextColor="White"
