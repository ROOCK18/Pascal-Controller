                            <Border x:Name="Relay1DayCs" BackgroundColor="#444" StrokeShape="RoundRectangle 6" Padding="10,6"><Label Text="CS" TextColor="White" FontSize="13"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRelay1DayTapped" CommandParameter="3"/></Border.GestureRecognizers></Border>
                            <Border x:Name="Relay1DayP"  BackgroundColor="#444" StrokeShape="RoundRectangle 6" Padding="10,6"><Label Text="P"  TextColor="White" FontSize="13"/><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRelay1DayTapped" CommandParameter="4"/></Border.GestureRecognizers></Border>
