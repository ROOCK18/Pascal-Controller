                            </Picker>
                        </Grid>
                        <VerticalStackLayout x:Name="Relay2ThermoNormal" Spacing="10">
                        <Border BackgroundColor="#1A1A1A" StrokeShape="RoundRectangle 8" Padding="12">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Hiszterézis — relé nem csapkod a küszöb körül" TextColor="Gray" FontSize="11"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label x:Name="Relay2OnLabel" Text="Bekapcsol (°C)" TextColor="Gray" FontSize="11"/>
                                        <Entry x:Name="Relay2TOn" Text="30" Keyboard="Numeric"
                                               BackgroundColor="#3A3A3A" TextColor="White"
                                               HorizontalTextAlignment="Center" HeightRequest="44"
                                               TextChanged="OnRelay2ThermoChanged"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label x:Name="Relay2OffLabel" Text="Kikapcsol (°C)" TextColor="Gray" FontSize="11"/>
                                        <Entry x:Name="Relay2TOff" Text="25" Keyboard="Numeric"
                                               BackgroundColor="#3A3A3A" TextColor="White"
                                               HorizontalTextAlignment="Center" HeightRequest="44"
                                               TextChanged="OnRelay2ThermoChanged"/>
                                    </VerticalStackLayout>
                                </Grid>
                                <GraphicsView x:Name="Relay2ThermoGraph" HeightRequest="90"/>
                            </VerticalStackLayout>
                        </Border>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Érzékelő" TextColor="Gray" FontSize="11"/>
                                <Picker x:Name="Relay2ThermoSensor" SelectedIndexChanged="OnRelay2ThermoChanged" BackgroundColor="#3A3A3A" TextColor="White">
                                    <Picker.Items><x:String>NTC1 (T1)</x:String><x:String>NTC2 (T2)</x:String></Picker.Items>
                                </Picker>
                            </VerticalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="#1A1A1A" StrokeShape="RoundRectangle 8" Padding="12">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label x:Name="Relay2CurrentLabel" Text="Aktuális hőmérséklet" TextColor="Gray" FontSize="10"/>
                                    <Label x:Name="Relay2CurrentTemp" Text="-- °C"
                                           TextColor="{StaticResource PrimaryRed}" FontSize="18" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Button Grid.Column="0" Text="TERMOSZTÁT MENTÉSE AZ ESP-BE" Clicked="OnRelay2ThermoSave"
                                    BackgroundColor="{StaticResource PrimaryRed}" TextColor="White"
                                    FontAttributes="Bold" CornerRadius="8" HeightRequest="42"/>
                            <Button Grid.Column="1" Text="Törlés" Clicked="OnRelay2ThermoDelete"
                                    BackgroundColor="#444444" TextColor="White"
                                    CornerRadius="8" HeightRequest="42" WidthRequest="80"/>
                        </Grid>
                        <Label x:Name="Relay2ThermoStatus" Text="" TextColor="Gray" FontSize="11" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <!-- Relay2 Kapcsoló-logika (csak "2 kapcsoló" módban látszik) -->
                        <VerticalStackLayout x:Name="Relay2LogicSection" Spacing="10" IsVisible="False">
                            <Label x:Name="Relay2LogicIntro" Text="Add meg K1/K2 minden állapot-kombinációjához, hogy a relé húzzon-e" TextColor="Gray" FontSize="11"/>
                            <VerticalStackLayout x:Name="Relay2LogicThresholdSection" Spacing="4" IsVisible="False">
                                <Label Text="Hőmérséklet küszöb (°C) - ez választja el az 'Alacsony'/'Magas' esetet" TextColor="Gray" FontSize="11"/>
                                <Entry x:Name="Relay2LogicThreshold" Text="30" Keyboard="Numeric"
                                       BackgroundColor="#3A3A3A" TextColor="White"
                                       HorizontalTextAlignment="Center" HeightRequest="40"/>
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                                <Label Grid.Row="0" Grid.Column="0" x:Name="Relay2LogicRow1" Text="K1: Nyitott · K2: Nyitott" TextColor="White" FontSize="13" VerticalOptions="Center"/>
                                <Switch Grid.Row="0" Grid.Column="1" x:Name="Relay2LogicOO"/>
                                <Label Grid.Row="1" Grid.Column="0" x:Name="Relay2LogicRow2" Text="K1: Nyitott · K2: Zárt" TextColor="White" FontSize="13" VerticalOptions="Center"/>
                                <Switch Grid.Row="1" Grid.Column="1" x:Name="Relay2LogicOC"/>
                                <Label Grid.Row="2" Grid.Column="0" x:Name="Relay2LogicRow3" Text="K1: Zárt · K2: Nyitott" TextColor="White" FontSize="13" VerticalOptions="Center"/>
                                <Switch Grid.Row="2" Grid.Column="1" x:Name="Relay2LogicCO"/>
                                <Label Grid.Row="3" Grid.Column="0" x:Name="Relay2LogicRow4" Text="K1: Zárt · K2: Zárt" TextColor="White" FontSize="13" VerticalOptions="Center"/>
                                <Switch Grid.Row="3" Grid.Column="1" x:Name="Relay2LogicCC"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Button Grid.Column="0" Text="LOGIKA MENTÉSE AZ ESP-BE" Clicked="OnRelay2LogicSave"
                                        BackgroundColor="{StaticResource PrimaryRed}" TextColor="White"
                                        FontAttributes="Bold" CornerRadius="8" HeightRequest="42"/>
                                <Button Grid.Column="1" Text="Törlés" Clicked="OnRelay2LogicDelete"
                                        BackgroundColor="#444444" TextColor="White"
                                        CornerRadius="8" HeightRequest="42" WidthRequest="80"/>
                            </Grid>
                            <Label x:Name="Relay2LogicStatus" Text="" TextColor="Gray" FontSize="11" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
