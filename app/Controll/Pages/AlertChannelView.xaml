<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Controll.Pages.AlertChannelView">

    <!-- Egy csatorna figyelmeztetései (ventilátor 1-2, relé 1-2): legördülő, alapból összecsukva. Lenyitva azonnal látszik
         minden beállítás, a tetején a bekapcsoló kapcsolóval. A csatorna szenzora a termosztátjáé. -->
    <VerticalStackLayout Spacing="8">
        <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <Label Grid.Column="0" Text="Figyelmeztetés" FontSize="15" FontAttributes="Bold" TextColor="White" />
            <Label Grid.Column="1" x:Name="ExpandIcon" Text="&#9660;" TextColor="White" FontSize="16" VerticalOptions="Center" />
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnHeaderTapped"/>
            </Grid.GestureRecognizers>
        </Grid>

        <VerticalStackLayout x:Name="DetailsPanel" Spacing="8" IsVisible="False">
            <HorizontalStackLayout Spacing="10">
                <Label Text="Bekapcsolva" TextColor="Gray" FontSize="13" VerticalOptions="Center" />
                <Switch x:Name="EnabledSwitch" />
            </HorizontalStackLayout>

            <Label Text="Értesítést kapsz a telefonra, ha a csatorna hőmérője meghibásodik, vagy a hőmérséklet kilép a megadott határok közül. Az értesítés akkor érkezik meg, ha a telefon kapcsolatban van az eszközzel." TextColor="Gray" FontSize="12" />

            <HorizontalStackLayout Spacing="10">
                <Label Text="Szenzorhiba" TextColor="Gray" FontSize="13" VerticalOptions="Center" />
                <Switch x:Name="FaultSwitch" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10">
                <Label Text="Túl alacsony hőmérséklet" TextColor="Gray" FontSize="13" VerticalOptions="Center" />
                <Switch x:Name="LowSwitch" />
            </HorizontalStackLayout>
            <Label Text="Alsó határ (°C)" TextColor="Gray" FontSize="12" />
            <Entry x:Name="LowEntry" Keyboard="Numeric" TextColor="White" BackgroundColor="#3A3A3A" HeightRequest="40" Text="5" />

            <HorizontalStackLayout Spacing="10">
                <Label Text="Túl magas hőmérséklet" TextColor="Gray" FontSize="13" VerticalOptions="Center" />
                <Switch x:Name="HighSwitch" />
            </HorizontalStackLayout>
            <Label Text="Felső határ (°C)" TextColor="Gray" FontSize="12" />
            <Entry x:Name="HighEntry" Keyboard="Numeric" TextColor="White" BackgroundColor="#3A3A3A" HeightRequest="40" Text="35" />

            <Border BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="42">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSaveTapped"/></Border.GestureRecognizers>
                <Label Text="FIGYELMEZTETÉS MENTÉSE" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
