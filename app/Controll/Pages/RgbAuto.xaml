<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Controll.Pages"
             x:Class="Controll.Pages.RgbAuto"
             BackgroundColor="{StaticResource GraphiteGray}">

    <!-- RGB automatikák: Automata/Kézi + négy legördülő (időzítő, hőmérséklet-görbe, napszak-görbe, közeledés) -->
    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <Border BackgroundColor="{StaticResource PrimaryRed}" StrokeShape="RoundRectangle 40,0,0,40" HeightRequest="44">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBackClicked"/></Border.GestureRecognizers>
                <Label Text="← Vissza az RGB-hez" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <Border BackgroundColor="#2C2C2C" StrokeShape="RoundRectangle 12" Padding="14">
                <VerticalStackLayout Spacing="0">
                    <Label Text="RGB automatikák" FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                    <Label Text="Az automatikák csak Automata állapotban működnek." TextColor="#AEAEB2" FontSize="12" HorizontalOptions="Center" Margin="0,4,0,6" />
                    <pages:RgbAutoToggle HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#2C2C2C" StrokeShape="RoundRectangle 12" Padding="14">
                <VerticalStackLayout Spacing="2">
                    <pages:RgbSeriesView x:Name="TimerView" Kind="Timer" Margin="0,-10,0,0" />
                    <BoxView HeightRequest="1" Color="#3A3A3A" />
                    <pages:RgbSeriesView x:Name="ThermView" Kind="Therm" />
                    <BoxView HeightRequest="1" Color="#3A3A3A" />
                    <pages:RgbSeriesView x:Name="DayView" Kind="Day" />
                    <BoxView HeightRequest="1" Color="#3A3A3A" />
                    <!-- a Közeledés legördülő (bekapcsolóval és az összes beállítással) magában a nézetben van -->
                    <pages:ProxChannelView x:Name="ProxRgbView" ChannelKey="RGB" Kind="Rgb" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
