void drawAmicroLogo(int16_t x, int16_t y) {
    const int w = 80;
    const int h = 80;
    
    tft.startWrite();
    for (int16_t j = 0; j < h; j++) {
        for (int16_t i = 0; i < w; i++) {
            uint8_t val = pgm_read_byte(&amicro_logo_map[j * w + i]);
            uint16_t color;
            
            switch(val) {
                case 1:  color = ST77XX_BLACK; break;
                case 2:  color = ST77XX_RED;   break;
                default: color = ST77XX_WHITE; break;
            }
            tft.writePixel(x + i, y + j, color);
        }
    }
    tft.endWrite();
}

// --- CALLBACK OSZTÁLY ---
class MyCallbacks: public BLECharacteristicCallbacks {
    void onWrite(BLECharacteristic *pCharacteristic) {
        size_t len = pCharacteristic->getLength();
        if (len == 0) return;
        uint8_t* data = pCharacteristic->getData();

        if (!otaInProgress) {
            // Parancs értelmezése (UPDATE:XXXXX)
            String cmd = "";
            for(int i=0; i<len; i++) cmd += (char)data[i];
            cmd.trim();

            if (cmd.startsWith("UPDATE:")) {
                fullSize = cmd.substring(7).toInt();
                if (fullSize > 0 && Update.begin(fullSize)) {
                    otaInProgress = true;
                    currentSize = 0;
                    
                    // Várólista ürítése
                    portENTER_CRITICAL(&dataMux);
                    while(!dataQueue.empty()) dataQueue.pop();
                    portEXIT_CRITICAL(&dataMux);
                    
                    // Visszajelzés a telefonnak
                    pTxCharacteristic->setValue("READY\n");
                    pTxCharacteristic->notify();
                    
                    Serial.printf("OTA indulas: %u bajt\n", fullSize);
                    
                    // Kijelző jelzés
                    //tft.fillScreen(ST77XX_BLUE);
                    tft.fillScreen(ST77XX_WHITE); // Alapértelmezett fehér háttér
                    drawAmicroLogo((tft.width() - 80) / 2, (tft.height() - 80) / 2);
                    tft.setCursor(10, 10);
                    tft.setTextColor(ST77XX_WHITE);
                    tft.print("OTA: ADATFOGADAS...");
                    
                }
            }
        } else {
            // BINÁRIS ADATCSOMAG ÉRKEZETT
            OtaPacket packet;
            packet.len = (len > 512) ? 512 : len; 
            memcpy(packet.data, data, packet.len);

            portENTER_CRITICAL(&dataMux);
            dataQueue.push(packet);
            portEXIT_CRITICAL(&dataMux);

            // Handshake nyugtázás (OK küldése minden csomag után)
            pTxCharacteristic->setValue("OK\n");
            pTxCharacteristic->notify();
        }
    }
};

void setup() {
    Serial.begin(115200);

    // Kijelző inicializálása
    pinMode(TFT_BL, OUTPUT);
    digitalWrite(TFT_BL, HIGH);
    SPI.begin(TFT_SCLK, -1, TFT_MOSI);
    tft.init(135, 240);
    tft.setRotation(3);
    tft.fillScreen(ST77XX_BLACK);
    tft.setCursor(10, 10);
    tft.setTextColor(ST77XX_WHITE);
    tft.print("Varakozas Bluetooth-ra...");

    // Bluetooth inicializálása
    BLEDevice::init("Pascal-Controller");
    BLEDevice::setMTU(512); // MTU beállítása 512-re

    BLEServer *pServer = BLEDevice::createServer();
    BLEService *pService = pServer->createService(SERVICE_UUID);

    // TX Karakterisztika (Visszajelzéshez)
    pTxCharacteristic = pService->createCharacteristic(
        CHARACTERISTIC_UUID_TX, 
        BLECharacteristic::PROPERTY_NOTIFY
    );
    pTxCharacteristic->addDescriptor(new BLE2902());

    // RX Karakterisztika (Íráshoz)
    BLECharacteristic *pRxCharacteristic = pService->createCharacteristic(
        CHARACTERISTIC_UUID_RX, 
        BLECharacteristic::PROPERTY_WRITE | BLECharacteristic::PROPERTY_WRITE_NR
    );
    pRxCharacteristic->setCallbacks(new MyCallbacks());

    pService->start();
    pServer->getAdvertising()->addServiceUUID(SERVICE_UUID);
    pServer->getAdvertising()->start();
    
    Serial.println("Bluetooth kész, várjuk a csatlakozást...");
}

void loop() {
    if (otaInProgress) {
        if (!dataQueue.empty()) {
            OtaPacket packet;
            
            portENTER_CRITICAL(&dataMux);
            packet = dataQueue.front();
            dataQueue.pop();
            portEXIT_CRITICAL(&dataMux);

            if (Update.write(packet.data, packet.len) != packet.len) {
                Serial.printf("Flash hiba: %s\n", Update.errorString());
                tft.fillScreen(ST77XX_RED);
                otaInProgress = false;
            } else {
                currentSize += packet.len;
            }

            static int lastPercent = -1;
            int percent = (currentSize * 100) / fullSize;
            if (percent % 2 == 0 && percent != lastPercent) {
                lastPercent = percent;
                Serial.printf("Progress: %d%%\n", percent);
                
                int barWidth = (percent * 200) / 100;
                tft.fillRect(20, 100, barWidth, 10, ST77XX_GREEN);
            }
        }

        // AUTO-FINISH (biztonsági fallback)
        if (currentSize >= fullSize && fullSize > 0 && dataQueue.empty()) {
            Serial.printf("=== AUTO-FINISH === currentSize=%u / fullSize=%u\n", currentSize, fullSize);
            delay(1200);
            if (Update.end(true)) {
                Serial.println("OTA SIKERES! (auto) Újraindítás...");
                ESP.restart();
            } else {
                Serial.println("Update.end() HIBA! (auto)");
                Update.printError(Serial);
                otaInProgress = false;
            }
        }
    }
    
    yield();
    delay(1);
}